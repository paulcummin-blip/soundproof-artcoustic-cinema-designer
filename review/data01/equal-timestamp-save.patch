+
+test("a screen edit cannot undo a six-seat save with the same timestamp", async () => {
+  const f = fixture();
+  const baseline = f.baseline();
+  const draft = {seats: 4, screen: 65};
+  f.race(row => { row.design_state = {seats: 6, screen: 55}; });
+
+  await assert.rejects(saveDesignConditionally(baseline, draft, () => {}, f.client), {
+    code: DESIGN_CONFLICT,
+    message: /Your unsaved edits are kept in this tab/,
+  });
+  assert.deepEqual(f.rows.ProjectVersion.design_state, {seats: 6, screen: 55});
+  assert.deepEqual(draft, {seats: 4, screen: 65});
+  await assert.rejects(saveDesignConditionally(baseline, draft, () => {}, f.client), {code: DESIGN_CONFLICT});
+  assert.equal(f.calls, 1);
+});
