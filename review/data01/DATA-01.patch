new file mode 100644
index 0000000..c7b59c9
--- /dev/null
+++ b/src/components/state/sharedRoomSave.js
@@ -0,0 +1,17 @@
+const geometry = ['roomDims','room_width','room_length','room_height','screen_wall'];
+export const includesRoomField = patch => geometry.some(key=>Object.hasOwn(patch,key));
+
+export async function sendSharedRoomSave(client, row, patch) {
+  const expected = Object.fromEntries([...new Set([...geometry,...Object.keys(patch)])].map(key=>[key,row[key] ?? null]));
+  const response = await client.functions.invoke('saveSharedRoom',{project_id:row.id,expected,patch});
+  const result = response?.data ?? response;
+  if (result?.updated !== 1 || result.project?.id !== row.id) throw new Error('The shared room save was not confirmed.');
+  return result.project;
+}
+
+// The edit dialog and legacy adapter submit sparse, intentional field edits.
+export async function saveProjectEdit(client, id, patch) {
+  if (!includesRoomField(patch)) return client.entities.Project.update(id,patch);
+  const row = await client.entities.Project.get(id);
+  return sendSharedRoomSave(client,row,patch);
+}
