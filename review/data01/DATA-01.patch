diff --git a/test/data01-publication-reservation.test.mjs b/test/data01-publication-reservation.test.mjs
new file mode 100644
index 0000000..9202f20
--- /dev/null
+++ b/test/data01-publication-reservation.test.mjs
@@ -0,0 +1,201 @@
+import test, { after } from 'node:test';
+import assert from 'node:assert/strict';
+import { isDeepStrictEqual } from 'node:util';
+import { DatabaseSync } from 'node:sqlite';
+import { mkdtempSync, readFileSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { build } from 'esbuild';
+
+const dir = mkdtempSync(join(tmpdir(), 'publication-acceptance-'));
+after(() => rmSync(dir, {recursive:true, force:true}));
+const producer = readFileSync('test/engineering-publication-producer-contract.test.mjs','utf8');
+const sample = JSON.parse(producer.match(/^const fixture=(.*);$/m)[1]);
+const projectId = 'fixture-project';
+const versionId = 'fixture-version';
+const accountId = 'fixture-account';
+const design = {layout:'original'};
+
+async function handler(name) {
+  const outfile = join(dir,name+'.mjs');
+  await build({entryPoints:['base44/functions/'+name+'/entry.ts'],outfile,bundle:true,format:'esm',platform:'node',
+    plugins:[{name:'test-boundaries',setup(plugin) {
+      plugin.onResolve({filter:/^npm:@base44\/sdk/},()=>({path:'sdk',namespace:'fixture'}));
+      plugin.onResolve({filter:/\/accountAccessAuthority.js$/},()=>({path:'access',namespace:'fixture'}));
+      plugin.onLoad({filter:/.*/,namespace:'fixture'},args=>({contents:args.path === 'sdk'
+        ? 'export const createClientFromRequest=()=>globalThis.data01Client;'
+        : 'export const resolveAccountAccess=async (client,user)=>({user}); export const assertCapability=()=>{};'}));
+    }}]});
+  return (await import(outfile)).default;
+}
+const publish = await handler('publishEngineering');
+const read = await handler('readPublishedEngineering');
+const proposal = await handler('readProposalReportEvidence');
+
+function recordStore(t) {
+  const db = new DatabaseSync(join(dir,crypto.randomUUID()+'.sqlite'));
+  t.after(()=>db.close());
+  db.exec('CREATE TABLE records(kind TEXT,id TEXT,body TEXT,PRIMARY KEY(kind,id))');
+  const put = (kind,row)=>db.prepare('INSERT OR REPLACE INTO records VALUES(?,?,?)').run(kind,row.id,JSON.stringify(row));
+  const rows = kind=>db.prepare('SELECT body FROM records WHERE kind=? ORDER BY id').all(kind).map(r=>JSON.parse(r.body));
+  const matches = (row,query)=>Object.entries(query).every(([key,value])=>{
+    const actual=key.split('.').reduce((item,part)=>item?.[part],row) ?? null;
+    return value?.$in ? value.$in.includes(actual) : isDeepStrictEqual(actual,value ?? null);
+  });
+  const state = {put,rows,intercept:async()=>{},attempts:[]};
+  const entities = Object.fromEntries(['Project','ProjectVersion','ProjectAnalysisCache','ReportSnapshot'].map(kind=>[kind,{
+    filter: async (q,sort,limit=50,skip=0)=>{
+      const result=rows(kind).filter(row=>matches(row,q));
+      return sort && typeof sort==='object' ? {items:result.slice(0,sort.limit)} : result.slice(skip,skip+limit);
+    },
+    get:async id=>rows(kind).find(row=>row.id===id),
+    create:async fields=>{const row={...fields,id:crypto.randomUUID(),updated_date:'equal-time'};put(kind,row);return row;},
+    updateMany:async (q,patch)=>{
+      const phase = kind==='ProjectAnalysisCache'?'stage':patch.$set.pending_publication?'claim':'commit';
+      state.attempts.push(phase);
+      if (await state.intercept(phase,q,patch) === false) return {updated:0};
+      const matched=rows(kind).filter(row=>matches(row,q));
+      for (const row of matched) put(kind,{...row,...patch.$set});
+      return {updated:matched.length};
+    },
+  }]));
+  put('Project',{id:projectId,account_id:accountId});
+  put('ProjectVersion',{id:versionId,version_name:'Test',project_id:projectId,account_id:accountId,design_state:design,updated_date:'equal-time'});
+  put('ProjectAnalysisCache',{id:'row-a',project_id:projectId,version_id:versionId,account_id:accountId,updated_date:'equal-time',engineering_publications:{}});
+  globalThis.data01Client={entities,auth:{me:async()=>({account_id:accountId})},asServiceRole:{entities}};
+  return Object.assign(state,{entities,version:()=>rows('ProjectVersion')[0],cache:()=>rows('ProjectAnalysisCache')[0]});
+}
+function payload(fingerprint) {
+  const data=structuredClone(sample);
+  Object.assign(data.report_snapshot.report_project,{project_id:projectId,version_id:versionId,version_name:'Test'});
+  return {...data,engineering_fingerprint:fingerprint,project_id:projectId,version_id:versionId,expected_design_state:design};
+}
+async function call(fn,body) {
+  const res=await fn(new Request('https://fixture.invalid',{method:'POST',body:JSON.stringify(body)}));
+  return {status:res.status,data:await res.json()};
+}
+const current=()=>call(read,{project_id:projectId,version_id:versionId});
+async function save(fp) {
+  const r=await call(publish,payload(fp));
+  assert.equal(r.status,200,JSON.stringify(r.data).slice(0,600));
+  assert.equal(r.data.acknowledgement.durably_published,true);
+}
+function pauseAt(store,stage) {
+  const paused=Promise.withResolvers(),resume=Promise.withResolvers();
+  store.intercept=async phase=>{
+    if (phase===stage) {store.intercept=async()=>{};paused.resolve();await resume.promise;}
+  };
+  return {paused:paused.promise,resume:resume.resolve};
+}
+
+test('ordinary publication commits identity, initializes legacy revision and cold reads the pinned evidence',async t=>{
+  const s=recordStore(t);
+  await save('first');
+  assert.equal(s.version().published_cache_record_id,'row-a');
+  assert.equal(s.cache().engineering_publications.first.engineering_fingerprint,'first');
+  assert.ok(s.cache().engineering_publications_revision);
+  s.put('ProjectAnalysisCache',{...s.cache(),id:'row-b',updated_date:'later',engineering_publications:{}});
+  assert.equal((await current()).data.acknowledgement.durably_published,true);
+  s.put('ProjectVersion',{...s.version(),published_cache_record_id:'row-b'});
+  assert.equal((await current()).data.acknowledgement.durably_published,false);
+  s.put('ProjectVersion',{...s.version(),published_cache_record_id:null});
+  assert.equal((await current()).data.acknowledgement.durably_published,true);
+});
+test('equal-time competing publishers and retention retain current and staged evidence during commit',async t=>{
+  const s=recordStore(t);
+  await save('previous');
+  const map=s.cache().engineering_publications;
+  for(let i=0;i<6;i++) map['old'+i]={published_at:'2099-01-01'};
+  s.put('ProjectAnalysisCache',{...s.cache(),engineering_publications:map});
+  const gate=pauseAt(s,'commit');
+  const writing=call(publish,payload('incoming'));
+  await gate.paused;
+  const other=await call(publish,payload('competing'));
+  assert.equal(other.status,409);
+  assert.equal(s.version().published_fingerprint,'previous');
+  assert.ok(s.cache().engineering_publications.previous);
+  assert.ok(s.cache().engineering_publications.incoming);
+  gate.resume();assert.equal((await writing).status,200);
+  assert.equal((await current()).data.publication.engineering_fingerprint,'incoming');
+});
+test('design save between stage and commit rejects superseded calculation',async t=>{
+  const s=recordStore(t);await save('previous');
+  const gate=pauseAt(s,'commit');
+  const writing=call(publish,payload('older'));await gate.paused;
+  s.put('ProjectVersion',{...s.version(),design_state:{layout:'revised'}});
+  gate.resume();assert.equal((await writing).status,409);
+  assert.equal((await current()).data.publication.engineering_fingerprint,'previous');
+  const subsequent=payload('revised');subsequent.expected_design_state={layout:'revised'};
+  assert.equal((await call(publish,subsequent)).status,200);
+});
+for (const phase of ['stage','commit']) test('interruption before '+phase+' preserves current and permits recovery',async t=>{
+  const s=recordStore(t);await save('previous');
+  s.intercept=async point=>{if(point===phase)throw Error('interrupted');};
+  assert.equal((await call(publish,payload('next'))).status,500);
+  assert.equal((await current()).data.publication.engineering_fingerprint,'previous');
+  assert.equal(Boolean(s.cache().engineering_publications.next),phase==='commit');
+  s.intercept=async()=>{};await save('next');
+  assert.equal(s.version().pending_publication,null);
+});
+test('expired reservation permits another calculation; resumed stale stage cannot erase its commit',async t=>{
+  const s=recordStore(t);await save('original');
+  const gate=pauseAt(s,'stage');const late=call(publish,payload('abandoned'));await gate.paused;
+  const v=s.version();v.pending_publication.started_at-=60000;s.put('ProjectVersion',v);
+  await save('replacement');gate.resume();assert.equal((await late).status,409);
+  assert.equal((await current()).data.publication.engineering_fingerprint,'replacement');
+});
+test('map nonce guards equal timestamps, conflicts remerge, retry budget ends at three',async t=>{
+  const s=recordStore(t);
+  s.intercept=async phase=>{
+    if(phase!=='stage')return;
+    s.intercept=async()=>{};
+    const row=s.cache();row.engineering_publications.guarded={published_at:'2025-01-01'};
+    row.engineering_publications_revision=crypto.randomUUID();s.put('ProjectAnalysisCache',row);
+  };
+  await save('first');assert.ok(s.cache().engineering_publications.guarded);
+  assert.equal(s.attempts.filter(x=>x==='stage').length,2);
+  s.attempts.length=0;s.intercept=async phase=>phase!=='stage';
+  assert.equal((await call(publish,payload('never'))).status,409);
+  assert.equal(s.attempts.filter(x=>x==='stage').length,3);
+  assert.equal((await current()).data.publication.engineering_fingerprint,'first');
+});
+test('a shared physical room edit at commit must also supersede the captured calculation',async t=>{
+  const s=recordStore(t);
+  const room=sample.report_snapshot.report_project;
+  const project={...s.rows('Project')[0],roomDims:room.roomDims,room_width:room.room_width,room_length:room.room_length,room_height:room.room_height};
+  s.put('Project',project);
+  await save('previous');
+  const gate=pauseAt(s,'commit');
+  const writing=call(publish,payload('older-room'));await gate.paused;
+  const width=project.room_width+1;
+  s.put('Project',{...project,room_width:width,roomDims:JSON.stringify({...JSON.parse(project.roomDims),widthM:width})});
+  gate.resume();
+  const response=await writing;
+  assert.deepEqual({status:response.status,pointer:s.version().published_fingerprint},{status:409,pointer:'previous'});
+});
+
+test('proposal evidence verifies the same committed row as the report and refuses an invalid explicit reference',async t=>{
+  const s=recordStore(t);
+  const {projectEvidence,savedProjectReport,ENGINEERING_FP} = await import('./fixtures/proposalReadinessFixtures.mjs');
+  await save(ENGINEERING_FP);
+  const evidence=projectEvidence({versionId});
+  evidence.identity.project_id=projectId;
+  for(const number of [12,13,18,19,20]) {
+    const source=evidence.parameter_index[number<18?'P4':'P14'];
+    const key='P'+number;
+    const entry={...source,key,parameter_id:number};
+    evidence.parameter_index[key]=entry;
+    evidence.parameters.push(entry);
+  }
+  const snapshot=savedProjectReport({versionId,evidence});
+  s.put('ReportSnapshot',{...snapshot,id:'report',project_id:projectId});
+  s.put('ProjectAnalysisCache',{...s.cache(),id:'row-b',engineering_publications:{}});
+  const request={project_id:projectId,version_ids:[versionId]};
+  const good=await call(proposal,request);
+  assert.equal(good.status,200,JSON.stringify(good.data).slice(0,500));
+  assert.equal(good.data.snapshots[0].engineeringState,'current');
+  assert.equal((await current()).data.publication.engineering_fingerprint,ENGINEERING_FP);
+  s.put('ProjectVersion',{...s.version(),published_cache_record_id:'row-b'});
+  assert.equal((await call(proposal,request)).status,409);
+  assert.equal((await current()).data.acknowledgement.durably_published,false);
+});
