@@ -0,0 +1,68 @@
+import {createClientFromRequest} from 'npm:@base44/sdk@0.8.40';
+import {roomKeys, roomPatch} from '../../shared/publicationRoom.js';
+
+const allowed = new Set([...roomKeys, 'room_dimensions_edited', 'name', 'client_name', 'project_reference',
+  'project_status', 'notes', 'dolby_config', 'target_spl', 'amplifier_power']);
+const conflict = () => Response.json({error:'DESIGN_SAVE_CONFLICT'}, {status:409});
+const expiry = 30000;
+
+export default async function(req) {
+  try {
+    const client = createClientFromRequest(req);
+    if (!await client.auth.me()) return Response.json({error:'UNAUTHENTICATED'},{status:401});
+    const {project_id:id, expected, patch} = await req.json();
+    if (!id || !expected || !patch || !Object.keys(patch).length ||
+        !roomKeys.some(k=>Object.hasOwn(patch,k)) ||
+        Object.keys(patch).some(k=>!allowed.has(k)) || Object.keys(expected).some(k=>!allowed.has(k)))
+      return Response.json({error:'INVALID_ROOM_SAVE'},{status:400});
+    // updateMany does not perform schema type validation. Apply only the
+    // existing save fields, with their normal scalar types.
+    for (const [key,value] of Object.entries(patch)) {
+      const numeric = ['room_width','room_length','room_height','target_spl','amplifier_power'].includes(key);
+      const valid = value === null || (numeric ? typeof value === 'number' && Number.isFinite(value)
+        : key === 'room_dimensions_edited' ? typeof value === 'boolean' : typeof value === 'string');
+      if (!valid || (key === 'screen_wall' && !['front','back','left','right'].includes(value)))
+        return Response.json({error:'INVALID_ROOM_SAVE'},{status:400});
+    }
+    const project = client.entities.Project;
+    const row = await project.get(id);
+    if (!row || row.id !== id) return Response.json({error:'PROJECT_NOT_FOUND'},{status:404});
+    const base = {id, account_id:row.account_id ?? null};
+    // Compare the caller's original values and all geometry representations.
+    // Include the fields in the final CAS as unrelated edits may run meanwhile.
+    const compare = {};
+    for (const k of new Set([...roomKeys, ...Object.keys(patch)])) {
+      if (!Object.hasOwn(expected,k) || (row[k] ?? null) !== expected[k]) return conflict();
+      compare[k] = expected[k];
+    }
+    const update = roomPatch(row, patch);
+    const prior = row.pending_room_save ?? null;
+    if (prior?.expires_at > Date.now()) return conflict();
+    const marker = {token:crypto.randomUUID(),expires_at:Date.now()+expiry};
+    // Claim using the caller's ordinary Project update permission before any
+    // service access. A stale/abandoned writer cannot commit under a new token.
+    const claim = await project.updateMany({...base,...compare,pending_room_save:prior},{$set:{pending_room_save:marker}});
+    if (claim.updated !== 1) return conflict();
+    const service = client.asServiceRole.entities;
+    let committed = false;
+    try {
+      // A sibling publisher that already checked the room loses its token here.
+      // A later claimant observes this marker or the new dimensions after staging.
+      const cleared = await service.ProjectVersion.updateMany({project_id:id,pending_publication:{$ne:null}},
+        {$set:{pending_publication:null}});
+      if (!Number.isInteger(cleared?.updated) || cleared.updated < 0 || cleared.has_more === true) throw Error('Unconfirmed publication cancellation.');
+      const saved = await service.Project.updateMany({...base,...compare,'pending_room_save.token':marker.token},
+        {$set:{...update,pending_room_save:null}});
+      if (saved.updated !== 1) return conflict();
+      committed = true;
+      return Response.json({updated:1, project:{...row,...update,pending_room_save:null}});
+    } finally {
+      // On error clear only our own marker. A lost response or process crash
+      // also expires safely: replacing the marker fences any delayed final CAS.
+      if (!committed) await project.updateMany({...base,'pending_room_save.token':marker.token},
+        {$set:{pending_room_save:null}}).catch(()=>{});
+    }
+  } catch (error) {
+    return Response.json({error:'ROOM_SAVE_FAILED',message:error?.message},{status:500});
+  }
+}
