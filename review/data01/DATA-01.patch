diff --git a/base44/shared/publicationRoom.js b/base44/shared/publicationRoom.js
new file mode 100644
index 0000000..1557102
--- /dev/null
+++ b/base44/shared/publicationRoom.js
@@ -0,0 +1,56 @@
+// Project holds physical dimensions. Frozen reports hold effective dimensions,
+// which swap width and length for a version oriented across the physical room.
+export const roomKeys = ['roomDims', 'room_width', 'room_length', 'room_height', 'screen_wall'];
+
+function parseDims(value) {
+  if (typeof value !== 'string') return value || {};
+  try { return JSON.parse(value) || {}; } catch { return {}; }
+}
+
+export function physicalRoom(project) {
+  const dims = parseDims(project?.roomDims);
+  return {
+    width: Number(dims.widthM ?? dims.width) || Number(project?.room_width) || 0,
+    length: Number(dims.lengthM ?? dims.length) || Number(project?.room_length) || 0,
+    height: Number(dims.heightM ?? dims.height) || Number(project?.room_height) || 0,
+    wall: project?.screen_wall || 'front',
+  };
+}
+
+export function capturedRoom(report, design, screenWall) {
+  const viewed = physicalRoom(report);
+  const rotated = design?.room_orientation === 'width_front';
+  return { width: rotated ? viewed.length : viewed.width, length: rotated ? viewed.width : viewed.length,
+    height: viewed.height, wall: screenWall };
+}
+
+export function publicationRoom(entry, design) {
+  return entry?.source_physical_room ||
+    capturedRoom(entry?.report_snapshot?.report_project, design, entry?.report_snapshot?.report_project?.screen_wall || 'front');
+}
+
+export function matchesRoom(a, b) {
+  return a && b && a.width > 0 && a.length > 0 && a.height > 0 &&
+    a.width === b.width && a.length === b.length && a.height === b.height && a.wall === b.wall;
+}
+
+// A sparse edit of a legacy scalar must also update the canonical JSON value.
+// Keep unspecified axes. Null and zero remain explicit uncalculated dimensions.
+export function roomPatch(row, patch) {
+  if (!roomKeys.slice(0,4).some(key => Object.hasOwn(patch, key))) return patch;
+  const dims = physicalRoom(row);
+  const stated = parseDims(patch.roomDims);
+  const result = {...patch};
+  const room = {};
+  for (const axis of ['width', 'length', 'height']) {
+    const field = 'room_' + axis;
+    const key = axis + 'M';
+    const value = Object.hasOwn(patch, field) ? patch[field] : (stated[key] ?? stated[axis] ?? dims[axis]);
+    if (value !== null && (typeof value !== 'number' || !Number.isFinite(value) || value < 0))
+      throw new Error('Invalid room dimension.');
+    result[field] = value;
+    room[key] = value;
+  }
+  result.roomDims = JSON.stringify(room);
+  return result;
+}
