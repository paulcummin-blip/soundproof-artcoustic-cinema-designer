{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sound_proof_expiry_reconciliation",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "reconcile_expiry": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "manageSoundProofAccess",
            "args": {
              "action": "reconcile_expired"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Reconcile expired account access",
            "description": "Existing expiry authority across all expired active accounts; report incomplete enforcement through System Health."
          }
        }
      }
    ]
  },
  "name": "Sound Proof Expiry Reconciliation",
  "description": "Every five minutes reconcile expired active accounts using existing authority. Does not change licence dates, status, membership, promotions or Project Tokens; unchanged user flags are not rewritten."
}