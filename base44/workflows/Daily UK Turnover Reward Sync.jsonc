{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 2 * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Daily UK Turnover Reward Sync",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_uk_turnover_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_turnover": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncUkTurnoverRewards",
            "args": {
              "dry_run": false,
              "calendar_year": "${ now | strftime(\"%Y\") | tonumber }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Reconcile Lovable Professional Project entitlements",
            "description": "Reconcile the minimal Lovable entitlement contract into the append-only ledger"
          }
        }
      }
    ]
  },
  "description": "At 02:00 Europe/London, reconcile Lovable's minimal annual entitlement contract into Sound Proof's append-only Professional Project ledger. Missing thresholds are credited once; reduced entitlement creates explicit reversals; re-earned thresholds create explicit reinstatements. Invalid, duplicate, unavailable, or unsupported source data fails closed without commercial writes."
}