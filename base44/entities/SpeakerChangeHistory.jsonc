{
  "name": "SpeakerChangeHistory",
  "type": "object",
  "description": "Append-only audit log for every change to a SpeakerProduct. One record per field change. Provides full traceability for the Speaker Capability Database. Stores old value, new value, date, source, change type, and change reason.",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "ID of the SpeakerProduct that changed."
    },
    "field_changed": {
      "type": "string",
      "description": "The specification field that was changed."
    },
    "old_value": {
      "type": "string",
      "description": "The previous value before the change."
    },
    "new_value": {
      "type": "string",
      "description": "The new value after the change."
    },
    "source": {
      "type": "string",
      "description": "What triggered the change (e.g. 'Manual Edit', 'AI Extraction', 'Crawler', 'Import')."
    },
    "change_type": {
      "type": "string",
      "enum": [
        "Created",
        "Updated",
        "Removed",
        "Manual Edit"
      ],
      "description": "Type of change that occurred."
    },
    "change_reason": {
      "type": "string",
      "enum": [
        "Manufacturer Specification Update",
        "Manual Correction",
        "Crawler Import",
        "Document Revision",
        "URL Change",
        "Metadata Update",
        "Status Change",
        "Administrative"
      ],
      "description": "Reason the change was made. Controlled enum \u2014 no free text \u2014 so change patterns can be analysed over time. 'Manufacturer Specification Update' = the manufacturer published new data; 'Manual Correction' = a human fixed a typo or error; 'Crawler Import' = the automated crawler re-extracted; 'Document Revision' = the source PDF or document was updated; 'URL Change' = the source URL changed; 'Metadata Update' = non-spec metadata changed; 'Status Change' = product status changed; 'Administrative' = bulk admin action."
    }
  },
  "required": [
    "product_id",
    "field_changed",
    "change_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}