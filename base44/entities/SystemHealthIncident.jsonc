{
  "name": "SystemHealthIncident",
  "type": "object",
  "description": "Admin-only notification group record for the Sound Proof System Health & Error Intelligence system. One record per grouped operational failure, grouped by notification_group_key (mechanism + environment + account). Repeated occurrences of the same underlying problem increment the occurrence_count and create separate IncidentOccurrence records preserving full diagnostic evidence. Never stores proposal text, client briefs, passwords, tokens, secrets or confidential content. Created by trusted backend functions via the service role; read, updated and deleted by administrators only. Recovery attempts are recorded separately from permanent incident resolution: a recovery can restore a dealer's work while the underlying defect remains open for investigation.",
  "properties": {
    "runtime_environment": {
      "type": "string",
      "description": "Preview or deployed browser reporting the failure."
    },
    "incident_reference": {
      "type": "string",
      "description": "Unique human-readable reference (e.g. INC-261123-A1B2C3). Generated at creation time."
    },
    "first_detected_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this incident group was first detected."
    },
    "last_detected_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this incident group was most recently detected. Updated on each repeated occurrence."
    },
    "component": {
      "type": "string",
      "description": "The system component that failed (e.g. proposal_generation, operation_monitoring, report_export)."
    },
    "operation": {
      "type": "string",
      "description": "The specific operation that failed (e.g. generateProposal, report_export)."
    },
    "error_code": {
      "type": "string",
      "description": "A stable machine-readable error code (e.g. DRAFT_REJECTED, SECTION_MAPPING_FAILED, PROVIDER_FAILED, OPERATION_STALLED, UNEXPECTED_ERROR)."
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "description": "Initial severity of this incident group. The highest severity seen across all occurrences is tracked in highest_severity."
    },
    "highest_severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "nullable": true,
      "description": "The highest severity recorded across all occurrences in this group. Updated atomically when a new occurrence has a higher severity. Null until the first occurrence sets it."
    },
    "account_id": {
      "type": "string",
      "nullable": true,
      "description": "The affected dealer account ID, when available. Null for internal/admin operations."
    },
    "project_id": {
      "type": "string",
      "nullable": true,
      "description": "The affected project ID from the first occurrence, when available."
    },
    "proposal_id": {
      "type": "string",
      "nullable": true,
      "description": "The affected proposal ID, when a proposal was created before the failure."
    },
    "operation_id": {
      "type": "string",
      "nullable": true,
      "description": "Correlation ID linking this incident to its MonitoredOperation record. For proposal generation this is the request_id. For report export it is the client-generated UUID. Null when the incident was not associated with a monitored operation."
    },
    "operation_started_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "When the monitored operation started. Copied from the MonitoredOperation record at incident creation time."
    },
    "operation_last_progress_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "When the monitored operation last reported meaningful progress before the failure."
    },
    "operation_failed_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "When the failure was detected."
    },
    "stage_failed": {
      "type": "string",
      "nullable": true,
      "description": "The stage at which the operation stopped."
    },
    "stage_timeline": {
      "type": "array",
      "nullable": true,
      "description": "Safe timeline of meaningful stage transitions recorded by the monitored operation.",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "data_committed": {
      "type": "boolean",
      "nullable": true,
      "description": "Whether the failed operation committed any durable data before failing."
    },
    "data_integrity_summary": {
      "type": "string",
      "nullable": true,
      "description": "Safe plain-text summary of what was saved, rolled back or remains uncertain."
    },
    "cause_classification": {
      "type": "string",
      "enum": [
        "confirmed",
        "suspected",
        "unknown"
      ],
      "default": "unknown",
      "description": "How well the cause is established by the recorded evidence."
    },
    "cause_summary": {
      "type": "string",
      "nullable": true,
      "description": "Plain-text statement of what the recorded evidence shows about the cause."
    },
    "dealer_contacted": {
      "type": "boolean",
      "default": false,
      "description": "Whether an administrator has contacted the affected dealer about this incident."
    },
    "user_blocked": {
      "type": "boolean",
      "nullable": true,
      "description": "Whether the affected user remains blocked from their work."
    },
    "workaround_available": {
      "type": "boolean",
      "nullable": true,
      "description": "Whether a genuine workaround is available for the affected user."
    },
    "diagnostic_summary": {
      "type": "string",
      "description": "Safe, sanitized diagnostic summary for the first occurrence. Per-occurrence diagnostic details are preserved in IncidentOccurrence records."
    },
    "proposal_generation_id": {
      "type": "string",
      "nullable": true,
      "description": "Reference to the existing ProposalGeneration audit record for this failure."
    },
    "grouping_fingerprint": {
      "type": "string",
      "description": "Legacy grouping fingerprint from the original incident system. Retained for backward compatibility with historical records. New records use notification_group_key for grouping."
    },
    "notification_group_key": {
      "type": "string",
      "nullable": true,
      "description": "The notification group key: mechanism::environment::account_scope. Groups failures sharing the same underlying mechanism, runtime environment and affected account, across different operations, pages, projects and versions. Null on historical records that predate the new grouping."
    },
    "failure_mechanism": {
      "type": "string",
      "nullable": true,
      "description": "Normalized failure mechanism used for notification grouping (e.g. ENTITY_RATE_LIMIT_429, AUTHENTICATION_CONTEXT_FAILED)."
    },
    "http_status": {
      "type": "number",
      "nullable": true,
      "description": "HTTP status code from the first occurrence, when available. Used for mechanism classification."
    },
    "occurrence_count": {
      "type": "number",
      "default": 1,
      "description": "How many occurrences have been recorded in this notification group. Incremented atomically via $inc on each new occurrence. Each occurrence is also preserved as a separate IncidentOccurrence record."
    },
    "affected_production_accounts": {
      "type": "array",
      "nullable": true,
      "items": {
        "type": "string"
      },
      "description": "Production (deployed) account IDs that have been affected by this incident group. Used to detect when a new production dealer is affected and trigger an immediate notification. Accounts are added atomically via $addToSet."
    },
    "recovery_attempted": {
      "type": "boolean",
      "default": false,
      "description": "Whether an automatic recovery was attempted for this incident."
    },
    "recovery_successful": {
      "type": "boolean",
      "default": false,
      "description": "Whether the automatic recovery succeeded."
    },
    "recovery_summary": {
      "type": "string",
      "nullable": true,
      "description": "Short description of the recovery attempt and its outcome."
    },
    "incident_status": {
      "type": "string",
      "enum": [
        "open",
        "investigating",
        "resolved",
        "dismissed"
      ],
      "default": "open",
      "description": "The incident's lifecycle status. open = newly detected. investigating = an admin is looking into it. resolved = the underlying defect is fixed. dismissed = the admin determined no action is needed."
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "When the incident group was last resolved by an administrator. Used to detect recurrence: a new occurrence after resolution triggers a recurrence notification and reopens the group. Set by manageSystemHealthIncident when status changes to 'resolved'. Cleared when the group is reopened by a recurrence."
    },
    "admin_notes": {
      "type": "string",
      "nullable": true,
      "description": "Administrator's investigation notes."
    },
    "notification_status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed",
        "not_required",
        "skipped"
      ],
      "default": "pending",
      "description": "Email submission status for the most recent notification attempt. sent means the email service accepted the message."
    },
    "notification_sent_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "When the most recent alert email was successfully sent."
    },
    "notification_error": {
      "type": "string",
      "nullable": true,
      "description": "The error message when the most recent alert email failed to send."
    },
    "notifications_sent_count": {
      "type": "number",
      "default": 0,
      "description": "Total number of alert emails successfully sent for this notification group. Distinguishes the number of recorded failures (occurrence_count) from the number of emails sent (notifications_sent_count)."
    },
    "last_alert_sent_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "When the most recent alert email (any type: initial, escalation, new account, recurrence, reminder) was successfully sent. Used to enforce the 24-hour reminder limit."
    },
    "last_reminder_sent_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "When the most recent 24-hour reminder email was sent."
    },
    "initial_notification_claimed": {
      "type": "boolean",
      "default": false,
      "description": "Atomic claim flag for the initial notification. False = no initial email has been sent. Set to true atomically via conditional updateMany (initial_notification_claimed: false -> true) so concurrent occurrences cannot send duplicate initial emails. Reset to false when the group is resolved by an administrator."
    },
    "initial_notification_claim_token": {
      "type": "string",
      "nullable": true,
      "description": "The occurrence ID that claimed the initial notification. Used to release the claim on failed email delivery."
    },
    "initial_notification_claimed_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "When the initial notification was claimed."
    },
    "critical_notification_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether a critical escalation notification has been sent for this group. Set atomically via conditional updateMany. Reset to false when the group is resolved."
    },
    "critical_escalation_claim_token": {
      "type": "string",
      "nullable": true,
      "description": "The occurrence ID that claimed the critical escalation notification."
    },
    "critical_escalation_claimed_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "When the critical escalation notification was claimed."
    },
    "new_account_claim_token": {
      "type": "string",
      "nullable": true,
      "description": "The occurrence ID that claimed the new-account notification. Used to release the claim on failed email delivery."
    },
    "new_account_claimed_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "When the new-account notification was claimed."
    },
    "recurrence_claimed": {
      "type": "boolean",
      "default": false,
      "description": "Atomic claim flag for the recurrence notification. Set to true when a recurrence is claimed, preventing duplicate recurrence emails. Reset to false when the group is resolved by an administrator."
    },
    "recurrence_claim_token": {
      "type": "string",
      "nullable": true,
      "description": "The occurrence ID that claimed the recurrence notification."
    },
    "recurrence_claimed_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "When the recurrence notification was claimed."
    },
    "reminder_claim_token": {
      "type": "string",
      "nullable": true,
      "description": "Token for the current 24-hour reminder claim."
    },
    "test_run_id": {
      "type": "string",
      "nullable": true,
      "default": null,
      "description": "TEST ISOLATION MARKER. Null for all production incidents. When non-null, the record was created by a diagnostic test run. Cleanup must NEVER delete records where test_run_id is null."
    },
    "version_id": {
      "type": "string",
      "nullable": true,
      "description": "Affected saved design version ID from the first occurrence."
    },
    "page_path": {
      "type": "string",
      "nullable": true,
      "description": "Affected page path from the first occurrence."
    },
    "error_detail": {
      "type": "string",
      "nullable": true,
      "description": "Sanitized bounded browser error detail from the first occurrence."
    },
    "component_stack": {
      "type": "string",
      "nullable": true,
      "description": "Sanitized component or JavaScript stack from the first occurrence, bounded."
    },
    "account_name": {
      "type": "string",
      "nullable": true,
      "description": "Verified account name at incident time."
    },
    "dealer_name": {
      "type": "string",
      "nullable": true,
      "description": "Dealer name stamped on the affected project, or verified account name."
    },
    "project_name": {
      "type": "string",
      "nullable": true,
      "description": "Verified project name at incident time."
    },
    "client_name": {
      "type": "string",
      "nullable": true,
      "description": "Client display name from the verified project."
    },
    "project_reference": {
      "type": "string",
      "nullable": true,
      "description": "Reference from the verified project."
    },
    "version_name": {
      "type": "string",
      "nullable": true,
      "description": "Name from the verified project version."
    }
  },
  "required": [
    "incident_reference",
    "first_detected_at",
    "last_detected_at",
    "component",
    "operation",
    "error_code",
    "severity",
    "grouping_fingerprint",
    "incident_status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}