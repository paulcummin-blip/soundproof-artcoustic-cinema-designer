{
  "name": "SystemHealthIncident",
  "type": "object",
  "description": "Admin-only central incident record for the Sound Proof System Health & Error Intelligence system. One record per grouped operational failure. Repeated occurrences of the same underlying problem (same grouping fingerprint) increment the occurrence_count rather than creating a duplicate record. Never stores proposal text, client briefs, passwords, tokens, secrets or confidential content. Created by trusted backend functions (e.g. generateProposal on failure) via the service role; read, updated and deleted by administrators only. Recovery attempts are recorded separately from permanent incident resolution: a recovery can restore a dealer's work while the underlying defect remains open for investigation.",
  "properties": {
    "incident_reference": {
      "type": "string",
      "description": "Unique human-readable reference (e.g. INC-261123-A1B2C3). Generated at creation time. Shown to the dealer only after the record is successfully persisted."
    },
    "first_detected_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this incident was first detected."
    },
    "last_detected_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this incident was most recently detected. Updated on each repeated occurrence."
    },
    "component": {
      "type": "string",
      "description": "The system component that failed (e.g. proposal_generation, operation_monitoring, report_export)."
    },
    "operation": {
      "type": "string",
      "description": "The specific operation that failed (e.g. generateProposal, report_export)."
    },
    "error_code": {
      "type": "string",
      "description": "A stable machine-readable error code (e.g. DRAFT_REJECTED, SECTION_MAPPING_FAILED, PROVIDER_FAILED, OPERATION_STALLED, UNEXPECTED_ERROR)."
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "description": "Incident severity. critical = system broken (unexpected error, provider failure). high = content quality failure (draft rejected by validator). medium = structural failure (section mapping, stalled operation). low = pre-condition failure (writer refusal)."
    },
    "account_id": {
      "type": "string",
      "nullable": true,
      "description": "The affected dealer account ID, when available. Null for internal/admin operations."
    },
    "project_id": {
      "type": "string",
      "nullable": true,
      "description": "The affected project ID, when available."
    },
    "proposal_id": {
      "type": "string",
      "nullable": true,
      "description": "The affected proposal ID, when a proposal was created before the failure."
    },
    "operation_id": {
      "type": "string",
      "nullable": true,
      "description": "Correlation ID linking this incident to its MonitoredOperation record. For proposal generation this is the request_id. For report export it is the client-generated UUID. Null when the incident was not associated with a monitored operation."
    },
    "operation_started_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "When the monitored operation started. Copied from the MonitoredOperation record at incident creation time. Null when no monitored operation is linked."
    },
    "operation_last_progress_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "When the monitored operation last reported meaningful progress before the failure. Copied from the MonitoredOperation. Null when no progress was reported or no monitored operation is linked."
    },
    "operation_failed_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "When the failure was detected. For watchdog-confirmed stalls, this is the watchdog run time. For direct failures, this is the catch-block time. Null when the failure time is unknown."
    },
    "stage_failed": {
      "type": "string",
      "nullable": true,
      "description": "The stage at which the operation stopped (e.g. preparing_evidence, writing_proposal, validating, saving, capturing, uploading, verifying). Null when the stage is unknown."
    },
    "stage_timeline": {
      "type": "array",
      "nullable": true,
      "description": "Safe timeline of meaningful stage transitions recorded by the monitored operation. Each entry: {stage, timestamp}. Contains only stage names and timestamps, never proposal text or client data. Null when no timeline was recorded.",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "data_committed": {
      "type": "boolean",
      "nullable": true,
      "description": "Whether the failed operation committed any durable data before failing. True = a proposal, report or other record was saved. False = all data was rolled back. Null = unknown (no monitored operation linked)."
    },
    "data_integrity_summary": {
      "type": "string",
      "nullable": true,
      "description": "Safe plain-text summary of what was saved, rolled back or remains uncertain. Contains only operation outcomes (e.g. 'Proposal and all sections were rolled back. No durable data was committed.'). Never contains proposal text, client names or credentials. Null when the data integrity state is unknown."
    },
    "cause_classification": {
      "type": "string",
      "enum": [
        "confirmed",
        "suspected",
        "unknown"
      ],
      "default": "unknown",
      "description": "How well the cause is established by the recorded evidence. confirmed = the error code directly states the cause (DRAFT_REJECTED, PROVIDER_FAILED, SECTION_MAPPING_FAILED). suspected = the evidence is circumstantial (OPERATION_STALLED \u2014 no progress does not prove the cause). unknown = the error is unexpected and the cause has not been determined. Never set to confirmed based on a successful retry \u2014 a retry succeeding only proves the failure is intermittent, not that the cause is fixed."
    },
    "cause_summary": {
      "type": "string",
      "nullable": true,
      "description": "Plain-text statement of what the recorded evidence shows about the cause. Distinguishes what is confirmed from what is suspected. Never states a cause the evidence does not support. Null when no cause summary has been recorded."
    },
    "dealer_contacted": {
      "type": "boolean",
      "default": false,
      "description": "Whether an administrator has contacted the affected dealer about this incident. Set manually by an admin through the manageSystemHealthIncident function."
    },
    "user_blocked": {
      "type": "boolean",
      "nullable": true,
      "description": "Whether the affected user remains blocked from their work as a result of this incident. True = the user cannot proceed without a fix or workaround. False = the user can continue (e.g. they can retry, or the failure is non-blocking). Null = unknown. Never set to true unless the evidence supports it."
    },
    "workaround_available": {
      "type": "boolean",
      "nullable": true,
      "description": "Whether a genuine workaround is available for the affected user. True only when the actual recovery path supports it (e.g. retry available for DRAFT_REJECTED). False = no workaround exists. Null = unknown. Never set to true unless the recovery path supports it."
    },
    "diagnostic_summary": {
      "type": "string",
      "description": "Safe, sanitized diagnostic summary. Contains only error codes, violation codes, section types and operation names. Never contains proposal text, client names, project names, credentials or confidential content."
    },
    "proposal_generation_id": {
      "type": "string",
      "nullable": true,
      "description": "Reference to the existing ProposalGeneration audit record for this failure, when one was created. Allows an administrator to navigate from the incident to the full generation audit without duplicating sensitive content in the incident record."
    },
    "grouping_fingerprint": {
      "type": "string",
      "description": "Stable fingerprint used to group repeated occurrences of the same underlying problem. Computed from component + operation + error_code + sorted violation codes. Two failures with the same fingerprint are the same incident."
    },
    "occurrence_count": {
      "type": "number",
      "default": 1,
      "description": "How many times this grouped incident has been detected. Incremented on each repeated occurrence instead of creating a duplicate record."
    },
    "recovery_attempted": {
      "type": "boolean",
      "default": false,
      "description": "Whether an automatic recovery was attempted for this incident (e.g. the bounded wording correction in the proposal writer). True even when the recovery failed."
    },
    "recovery_successful": {
      "type": "boolean",
      "default": false,
      "description": "Whether the automatic recovery succeeded. False when no recovery was attempted or the recovery failed."
    },
    "recovery_summary": {
      "type": "string",
      "nullable": true,
      "description": "Short description of the recovery attempt and its outcome. Null when no recovery was attempted."
    },
    "incident_status": {
      "type": "string",
      "enum": [
        "open",
        "investigating",
        "resolved",
        "dismissed"
      ],
      "default": "open",
      "description": "The incident's lifecycle status. open = newly detected. investigating = an admin is looking into it. resolved = the underlying defect is fixed. dismissed = the admin determined no action is needed. Recovery success is tracked separately (recovery_successful) and does not automatically resolve the incident."
    },
    "admin_notes": {
      "type": "string",
      "nullable": true,
      "description": "Administrator's investigation notes. Added through the manageSystemHealthIncident function."
    },
    "notification_status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed",
        "not_required",
        "skipped"
      ],
      "default": "pending",
      "description": "The status of the email alert to nominated administrators. pending = not yet attempted. sent = email delivered. failed = email could not be sent. not_required = no recipients configured or alerts disabled. skipped = severity too low for an alert."
    },
    "notification_sent_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "When the alert email was successfully sent. Null when no email was sent."
    },
    "notification_error": {
      "type": "string",
      "nullable": true,
      "description": "The error message when the alert email failed to send. Null when the email was sent or not required."
    },
    "test_run_id": {
      "type": "string",
      "nullable": true,
      "default": null,
      "description": "TEST ISOLATION MARKER. Null for all production incidents. When non-null, the record was created by a diagnostic test run and carries the unique test-run identifier so cleanup can delete only that test run's records. Production incident recording always passes null (or omits this field). Cleanup must NEVER delete records where test_run_id is null. This field prevents diagnostic test cleanup from deleting real production incidents by ensuring test records are explicitly distinguishable from production records."
    }
  },
  "required": [
    "incident_reference",
    "first_detected_at",
    "last_detected_at",
    "component",
    "operation",
    "error_code",
    "severity",
    "grouping_fingerprint",
    "incident_status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}