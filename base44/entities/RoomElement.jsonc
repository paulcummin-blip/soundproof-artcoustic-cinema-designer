{
  "name": "RoomElement",
  "type": "object",
  "description": "Legacy room element record (doors, windows, projectors, skylights). Not referenced by the active Room Designer workflow (which stores room elements on the Project entity's room_elements array). Retained for historical records. Admin-only access: no dealer or anonymous read, create, update or delete.",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID of the project this element belongs to"
    },
    "type": {
      "type": "string",
      "enum": [
        "door",
        "window",
        "fireplace",
        "built_in",
        "projector",
        "skylight"
      ],
      "description": "Type of room element"
    },
    "surface": {
      "type": "string",
      "enum": [
        "wall",
        "ceiling"
      ],
      "default": "wall",
      "description": "Which room surface the element is mounted on. 'wall' (default) for wall-mounted elements (door, window, projector, etc.) whose position is described by the wall field. 'ceiling' for ceiling-mounted elements (skylight) whose position is described by x_m/y_m centre coordinates in the plan."
    },
    "wall": {
      "type": "string",
      "enum": [
        "front",
        "back",
        "left",
        "right"
      ],
      "description": "Which wall the element is on"
    },
    "width": {
      "type": "number",
      "description": "Width of the element in meters"
    },
    "height": {
      "type": "number",
      "description": "Height of the element in meters"
    },
    "x_position": {
      "type": "number",
      "description": "Position along the wall (0-1, where 0 is left/top edge)"
    },
    "z_position": {
      "type": "number",
      "default": 0,
      "description": "Height from floor in meters"
    },
    "clearance": {
      "type": "number",
      "default": 0.5,
      "description": "Required clearance around element in meters"
    },
    "name": {
      "type": "string",
      "description": "Custom name for the element"
    },
    "x_lens_m": {
      "type": "number",
      "description": "Projector lens centre X position in room space (meters)"
    },
    "y_lens_m": {
      "type": "number",
      "description": "Projector lens centre Y position in room space (meters)"
    },
    "z_lens_m": {
      "type": "number",
      "description": "Projector lens centre Z (height) position in room space (meters)"
    },
    "body_width_m": {
      "type": "number",
      "description": "Projector body width in meters (X-axis)"
    },
    "body_height_m": {
      "type": "number",
      "description": "Projector body height in meters (Z-axis)"
    },
    "body_depth_m": {
      "type": "number",
      "description": "Projector body depth in meters (Y-axis, front to back)"
    },
    "x_m": {
      "type": "number",
      "description": "Ceiling-mounted element centre X position in room space (meters, along the width axis). Used by skylights."
    },
    "y_m": {
      "type": "number",
      "description": "Ceiling-mounted element centre Y position in room space (meters, along the length axis). Used by skylights."
    },
    "length_m": {
      "type": "number",
      "description": "Element length in meters. For wall elements this is the along-wall span; for a ceiling skylight this is the X-axis (width) span of the opening."
    },
    "width_m": {
      "type": "number",
      "description": "Ceiling skylight Y-axis (depth) span of the opening in meters."
    }
  },
  "required": [
    "project_id",
    "type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}