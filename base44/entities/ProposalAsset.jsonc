{
  "name": "ProposalAsset",
  "type": "object",
  "description": "A visual asset (image) attached to a project for use in proposals. Supports cover images, front/rear views, plan views, elevation views, construction drawings, client logos, reference photography, technical drawings, documents, and gallery images. Each asset has a caption and drag-orderable position (used for gallery images). Linked to the project so assets exist independently of any generated Proposal record. Gallery images additionally store category and proposal_importance metadata to help the future Proposal Engine select the most appropriate images for each section.",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID of the Project this asset belongs to."
    },
    "account_id": {
      "type": "string",
      "description": "Denormalized account_id for RLS."
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "cover_image",
        "front_view",
        "rear_view",
        "plan",
        "elevation",
        "construction",
        "client_logo",
        "reference_photography",
        "technical_drawings",
        "documents",
        "gallery"
      ],
      "description": "Type of visual asset. Single-asset types (cover_image, front_view, rear_view, plan, elevation, construction, client_logo, reference_photography, technical_drawings, documents) have one image per project. Gallery allows multiple images with drag ordering, category, and proposal importance metadata."
    },
    "file_url": {
      "type": "string",
      "description": "URL of the uploaded image file (public storage)."
    },
    "caption": {
      "type": "string",
      "description": "Caption displayed with the asset in the proposal. For gallery images, this free-text caption will be supplied to GPT during proposal generation.",
      "default": ""
    },
    "order_index": {
      "type": "number",
      "default": 0,
      "description": "Display order. Used for gallery images as drag-and-drop sort order; the Proposal Engine uses this as an additional priority when importance is equal. Single-asset types use 0."
    },
    "category": {
      "type": "string",
      "enum": [
        "Seating",
        "Lighting",
        "Cabinetry",
        "Equipment",
        "Construction",
        "Interior",
        "Exterior",
        "Joinery",
        "Acoustic Treatment",
        "Plan",
        "Elevation",
        "Lifestyle",
        "Other"
      ],
      "default": "Other",
      "description": "Gallery image category. Helps the future Proposal Engine decide which images are most appropriate for each proposal section. Primarily for gallery images; single-asset types default to their type."
    },
    "proposal_importance": {
      "type": "string",
      "enum": [
        "Essential",
        "Preferred",
        "Optional",
        "Do Not Use"
      ],
      "default": "Preferred",
      "description": "Proposal priority for this image. The future Proposal Engine will always prioritise images in this order: Essential > Preferred > Optional. Images marked 'Do Not Use' must never be inserted automatically into proposals."
    },
    "usage": {
      "type": "string",
      "enum": [
        "cover",
        "gallery",
        "do_not_use"
      ],
      "default": "gallery",
      "description": "How the Proposal Engine should use this image. 'cover' = available as cover image, 'gallery' = include in gallery, 'do_not_use' = ignore (GPT will skip). Superseded by proposal_importance for gallery images but retained for backward compatibility."
    }
  },
  "required": [
    "project_id",
    "account_id",
    "asset_type",
    "file_url"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}