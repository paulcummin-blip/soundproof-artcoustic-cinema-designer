{
  "name": "ProposalAsset",
  "type": "object",
  "description": "A visual asset (image) attached to a project for use in reports and proposals. The project gallery is deliberately simple: one Cover Image plus Image 1 to Image 10, each with an optional caption. The slot field is the label authority. Legacy assets uploaded under the previous labelled model (front view, rear view, plan, elevation, construction, client logo, reference photography, technical drawings, documents, gallery) keep their asset_type and are placed into slots by the gallery mapping \u2014 they are never moved or deleted.",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID of the Project this asset belongs to."
    },
    "account_id": {
      "type": "string",
      "description": "Denormalized account_id for RLS."
    },
    "slot": {
      "type": "string",
      "enum": [
        "cover",
        "image_1",
        "image_2",
        "image_3",
        "image_4",
        "image_5",
        "image_6",
        "image_7",
        "image_8",
        "image_9",
        "image_10"
      ],
      "nullable": true,
      "description": "The image's place in the simple project gallery: 'cover' for the cover image, 'image_1' to 'image_10' for the ten project images. This is the label authority for the Project Images page, reports and proposals \u2014 an image never has to be declared as a front view, plan or construction shot. Null on images uploaded before the gallery was simplified: those are placed by their legacy asset_type through the gallery mapping, and the slot is stamped the next time the image is edited. Setting a slot never moves or deletes an image."
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "cover_image",
        "front_view",
        "rear_view",
        "plan",
        "elevation",
        "construction",
        "client_logo",
        "reference_photography",
        "technical_drawings",
        "documents",
        "gallery"
      ],
      "description": "Legacy asset type, retained so images uploaded under the previous labelled model are never lost or reinterpreted. New uploads record 'cover_image' for the cover slot and 'gallery' for every image slot. The gallery mapping places legacy values into slots: cover_image \u2192 cover, front_view \u2192 image_1, rear_view \u2192 image_2, plan \u2192 image_3, elevation \u2192 image_4, construction \u2192 image_5, client_logo \u2192 image_6, reference_photography \u2192 image_7, technical_drawings \u2192 image_8, documents \u2192 image_9; gallery images fill the next free image slot in order."
    },
    "file_url": {
      "type": "string",
      "description": "URL of the uploaded image file (public storage)."
    },
    "caption": {
      "type": "string",
      "description": "Optional caption displayed with the image in the proposal. The caption is where an image explains what it is \u2014 the gallery itself stays generic. For gallery images this free-text caption is supplied to GPT during proposal generation.",
      "default": ""
    },
    "order_index": {
      "type": "number",
      "default": 0,
      "description": "Fallback ordering for legacy images. The gallery slot number is the primary order; this is used only to place images that have no slot yet."
    },
    "category": {
      "type": "string",
      "enum": [
        "Seating",
        "Lighting",
        "Cabinetry",
        "Equipment",
        "Construction",
        "Interior",
        "Exterior",
        "Joinery",
        "Acoustic Treatment",
        "Plan",
        "Elevation",
        "Lifestyle",
        "Other"
      ],
      "default": "Other",
      "description": "Optional category retained from the older gallery model. Not required by the simple gallery: it stays on existing records and defaults to 'Other' on new uploads."
    },
    "proposal_importance": {
      "type": "string",
      "enum": [
        "Essential",
        "Preferred",
        "Optional",
        "Do Not Use"
      ],
      "default": "Preferred",
      "description": "Proposal priority retained from the older gallery model. The Proposal Engine prioritises Essential > Preferred > Optional, and never inserts an image marked 'Do Not Use' automatically. New uploads default to 'Preferred'."
    },
    "usage": {
      "type": "string",
      "enum": [
        "cover",
        "gallery",
        "do_not_use"
      ],
      "default": "gallery",
      "description": "How the Proposal Engine should use this image. 'cover' = available as cover image, 'gallery' = include in gallery, 'do_not_use' = ignore (GPT will skip). Superseded by proposal_importance for gallery images but retained for backward compatibility."
    }
  },
  "required": [
    "project_id",
    "account_id",
    "file_url"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}