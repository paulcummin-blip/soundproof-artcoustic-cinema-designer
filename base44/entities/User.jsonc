{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "account_id": {
      "type": "string",
      "description": "Authoritative primary Account id. Backend-managed.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "account_role": {
      "type": "string",
      "enum": [
        "admin",
        "account_user"
      ],
      "default": "account_user",
      "description": "admin identifies the single local account administrator. Backend-managed.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "access_level": {
      "type": "string",
      "enum": [
        "FULL_ACCESS",
        "SOUND_PROOF_ONLY",
        "PRICE_LIST_ONLY"
      ],
      "default": "FULL_ACCESS",
      "description": "Authoritative account access level. Backend-managed and enforced server-side.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "app_role": {
      "type": "string",
      "enum": [
        "Super Admin",
        "Administrator",
        "Designer Pro",
        "Designer Lite",
        "Viewer"
      ],
      "default": "Designer Lite",
      "description": "Legacy business role derived from access_level for compatibility.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "territory": {
      "type": "string",
      "enum": [
        "UK",
        "IE",
        "IN"
      ],
      "default": "UK",
      "description": "Pricing territory assigned to this user by an administrator. Drives the territory price list via usePriceCalculation. Null/missing resolves to UK at read time.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "license_account_type": {
      "type": "string",
      "enum": [
        "Free",
        "Standard",
        "Professional",
        "Enterprise",
        "Internal"
      ],
      "default": "Free",
      "description": "Commercial licensing plan tier. Infrastructure only \u2014 not enforced anywhere yet."
    },
    "license_account_status": {
      "type": "string",
      "enum": [
        "Active",
        "Trial",
        "Suspended",
        "Disabled"
      ],
      "default": "Active",
      "description": "Licensing account status. Infrastructure only \u2014 not enforced anywhere yet."
    },
    "license_active_project_allowance": {
      "type": "number",
      "default": 2,
      "description": "Active project allowance for this user's plan (Free=2, Standard=5, Professional=12, Enterprise=30, Internal=999999). Manually overridable. Not enforced anywhere yet."
    },
    "license_override_allowance": {
      "type": "number",
      "nullable": true,
      "description": "If populated, overrides the plan-based active project allowance. Not enforced anywhere yet."
    },
    "license_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Per-user licensing toggle reserved for future use. Not used anywhere yet."
    },
    "license_subscription_id": {
      "type": "string",
      "description": "Future billing field \u2014 subscription identifier. Not used anywhere yet."
    },
    "license_payment_status": {
      "type": "string",
      "description": "Future billing field \u2014 payment status. Not used anywhere yet."
    },
    "license_renewal_date": {
      "type": "string",
      "format": "date",
      "description": "Future billing field \u2014 renewal date. Not used anywhere yet."
    },
    "license_credit_balance": {
      "type": "number",
      "description": "Future billing field \u2014 credit balance. Not used anywhere yet."
    },
    "license_billing_notes": {
      "type": "string",
      "description": "Future billing field \u2014 internal billing notes. Not used anywhere yet."
    }
  }
}