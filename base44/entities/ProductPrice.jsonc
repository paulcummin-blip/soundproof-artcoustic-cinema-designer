{
  "name": "ProductPrice",
  "type": "object",
  "description": "Canonical Sound Proof Product Master record. One record per commercial SKU. Product identity, availability, selector roles and retail pricing live here; detailed acoustic engineering remains linked through engineering_key. Reads are capability-gated and writes are platform-admin only.",
  "properties": {
    "sku": {
      "type": "string",
      "description": "Stable unique commercial product ID / SKU. Soundbar size variants use model:value."
    },
    "label": {
      "type": "string",
      "description": "Canonical product display name."
    },
    "category": {
      "type": "string",
      "enum": [
        "Loudspeaker",
        "Subwoofer",
        "Amplifier",
        "Acoustic Treatment",
        "Accessory"
      ],
      "description": "Commercial product category."
    },
    "price_ex_vat": {
      "type": "number",
      "description": "Canonical retail price ex VAT in GBP. null means price not set; never convert null to zero.",
      "nullable": true
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Inactive products remain available to historical projects but are excluded from new selections and active price lookups."
    },
    "trashed": {
      "type": "boolean",
      "default": false,
      "description": "Trashed products are hidden from the Product Master entirely but preserved in the database for audit. Only unreferenced products can be trashed. Hard delete is not available."
    },
    "engineering_key": {
      "type": "string",
      "nullable": true,
      "description": "Read-only link to the established acoustic engineering record. This editor never invents or duplicates engineering data."
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "lcr",
          "centre_soundbar",
          "surround",
          "rear_surround",
          "front_wide",
          "overhead",
          "subwoofer"
        ]
      },
      "default": [],
      "description": "Sound Proof selector roles supplied by this commercial product."
    },
    "selector_order": {
      "type": "number",
      "nullable": true,
      "description": "Stable ordering within Sound Proof selectors."
    },
    "catalog_version": {
      "type": "number",
      "default": 1,
      "description": "Product Master schema version marker."
    },
    "role_migration_version": {
      "type": "number",
      "nullable": true,
      "description": "Set by the idempotent legacy selector-role migration. No default, so unmigrated records remain detectable."
    }
  },
  "required": [
    "sku",
    "label",
    "category"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.access_level": "FULL_ACCESS"
          }
        },
        {
          "user_condition": {
            "data.access_level": "PRICE_LIST_ONLY"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}