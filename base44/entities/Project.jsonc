{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Project name"
    },
    "client_name": {
      "type": "string",
      "description": "Client name"
    },
    "project_status": {
      "type": "string",
      "description": "Lifecycle status: Live, Prospective, Lost, Completed",
      "default": "Prospective"
    },
    "roomDims": {
      "type": "string",
      "description": "JSON string of room dimensions {widthM, lengthM, heightM}"
    },
    "room_length": {
      "type": "number",
      "description": "Room length in meters (legacy)"
    },
    "room_width": {
      "type": "number",
      "description": "Room width in meters (legacy)"
    },
    "room_height": {
      "type": "number",
      "description": "Room height in meters (legacy)"
    },
    "room_orientation": {
      "type": "string",
      "enum": [
        "length_front",
        "width_front"
      ],
      "default": "length_front"
    },
    "screen_wall": {
      "type": "string",
      "enum": [
        "front",
        "back",
        "left",
        "right"
      ],
      "default": "front"
    },
    "screen_size": {
      "type": "number",
      "description": "Screen width in inches",
      "default": 120
    },
    "screen_height_from_floor": {
      "type": "number",
      "default": 0.5
    },
    "aspect_ratio": {
      "type": "string",
      "enum": [
        "16:9",
        "2.35:1"
      ],
      "default": "16:9"
    },
    "manual_dimensions": {
      "type": "boolean",
      "default": false,
      "description": "If true, use manual screen width/height (meters)"
    },
    "manual_width_m": {
      "type": "number",
      "description": "Manual viewable width in meters"
    },
    "manual_height_m": {
      "type": "number",
      "description": "Manual viewable height in meters"
    },
    "viewing_level": {
      "type": "string",
      "enum": [
        "level1",
        "level2",
        "level3",
        "level4"
      ],
      "default": "level2"
    },
    "seating_positions": {
      "type": "array",
      "description": "Seating positions array",
      "items": {
        "type": "object"
      }
    },
    "row_spacing_m": {
      "type": "number",
      "default": 1.8,
      "description": "Centre-to-centre spacing between seat rows in meters"
    },
    "seats_per_row_by_row": {
      "type": "array",
      "description": "Per-row seat counts array [3, 5, 2]",
      "items": {
        "type": "number"
      }
    },
    "dolby_config": {
      "type": "string",
      "enum": [
        "5.1",
        "7.1",
        "5.1.2",
        "5.1.4",
        "7.1.2",
        "7.1.4",
        "9.1.2",
        "9.1.4",
        "9.1.6",
        "9.2.4",
        "9.4.2",
        "9.4.4",
        "9.4.6"
      ]
    },
    "selected_speakers": {
      "type": "array",
      "description": "Selected speakers array",
      "items": {
        "type": "object"
      }
    },
    "selected_speakers_by_role": {
      "type": "object",
      "description": "Speaker models by role for SPL handoff"
    },
    "spl_speaker_nodes": {
      "type": "array",
      "description": "Speaker placement nodes from SPL Calculator",
      "items": {
        "type": "object"
      }
    },
    "room_elements": {
      "type": "array",
      "description": "Room elements array",
      "items": {
        "type": "object"
      }
    },
    "subwoofers": {
      "type": "array",
      "description": "Subwoofer config array (legacy, superseded by subwooferInstances)",
      "items": {
        "type": "object"
      }
    },
    "subwooferInstances": {
      "type": "array",
      "description": "Canonical subwoofer instance array \u2014 the sole authority for bass analysis. Each item: {id, model, enabled, position:{x,y}, bottomHeightM, rotationDeg, positionSource, legacyGroup, symmetryLinkId, gainDb, delayMs, polarity}. position.z is NOT stored \u2014 derive centreZ = bottomHeightM + cabinetHeightM/2 at boundaries. front_subs_cfg/rear_subs_cfg remain as compatibility metadata only.",
      "items": {
        "type": "object"
      }
    },
    "target_spl": {
      "type": "number",
      "default": 85
    },
    "amplifier_power": {
      "type": "number"
    },
    "notes": {
      "type": "string",
      "description": "Project notes"
    },
    "show_zones": {
      "type": "boolean",
      "default": false,
      "description": "Whether RP22 pads overlay is enabled"
    },
    "show_angles": {
      "type": "boolean",
      "default": false,
      "description": "Whether angles overlay is enabled"
    },
    "screen_mount_mode": {
      "type": "string",
      "enum": [
        "baffle",
        "floating"
      ],
      "default": "baffle"
    },
    "float_depth_m": {
      "type": "number",
      "enum": [
        0,
        0.2,
        0.3
      ],
      "default": 0
    },
    "show_screen_plane": {
      "type": "boolean",
      "default": false
    },
    "show_cavity": {
      "type": "boolean",
      "default": false
    },
    "speaker_clearance_m": {
      "type": "number",
      "default": 0.02,
      "description": "Fixed screen\u2192speaker clearance (m)"
    },
    "seven_bed_layout_type": {
      "type": "string",
      "default": "rears",
      "description": "7.x bed layout choice: rears or wides"
    },
    "overlays": {
      "type": "object",
      "description": "Overlay visibility flags"
    },
    "overhead_global_model": {
      "type": "string",
      "default": "architect-2-1",
      "description": "Global overhead speaker model"
    },
    "overhead_front_override": {
      "type": "string",
      "description": "Front overhead position model override"
    },
    "overhead_mid_override": {
      "type": "string",
      "description": "Mid overhead position model override"
    },
    "overhead_rear_override": {
      "type": "string",
      "description": "Rear overhead position model override"
    },
    "use_front_global": {
      "type": "boolean",
      "default": true,
      "description": "Use global model for front overhead"
    },
    "use_mid_global": {
      "type": "boolean",
      "default": true,
      "description": "Use global model for mid overhead"
    },
    "use_rear_global": {
      "type": "boolean",
      "default": true,
      "description": "Use global model for rear overhead"
    },
    "screen_front_plane_m": {
      "type": "number",
      "description": "Screen front plane Y-coordinate in meters"
    },
    "lcr_aim_mode": {
      "type": "string",
      "description": "LCR speaker aim mode: flat or angled"
    },
    "enable_front_wides": {
      "type": "boolean",
      "default": false,
      "description": "Enable front wide speakers for 7.x layouts"
    },
    "front_subs_cfg": {
      "type": "object",
      "description": "Front subwoofer configuration (legacy compatibility metadata \u2014 not analysis authority)"
    },
    "rear_subs_cfg": {
      "type": "object",
      "description": "Rear subwoofer configuration (legacy compatibility metadata \u2014 not analysis authority)"
    },
    "spl_config": {
      "type": "object",
      "description": "SPL configuration"
    },
    "tv_preset_key": {
      "type": "string",
      "description": "TV preset identifier (e.g. tv83)",
      "nullable": true
    },
    "tv_width_mm": {
      "type": "number",
      "description": "Exact TV width in millimeters",
      "nullable": true
    },
    "seating_block_offset": {
      "type": "number",
      "description": "Viewing distance offset in meters",
      "default": 0
    },
    "mlp_basis": {
      "type": "string",
      "enum": [
        "front",
        "middle",
        "back",
        "all"
      ],
      "default": "middle",
      "description": "Reference for MLP calculation"
    },
    "border_thickness_m": {
      "type": "number",
      "description": "Screen border thickness in meters",
      "default": 0.08
    },
    "rsp_mode": {
      "type": "string",
      "enum": [
        "auto_from_screen",
        "front_row_center",
        "middle_row_center",
        "back_row_center",
        "all_rows_average",
        "manual_position"
      ],
      "default": "auto_from_screen",
      "description": "RSP source-of-truth mode. auto_from_screen = 57.5\u00b0 derived; *_row_* = seating-derived; manual_position = user-nominated Y."
    },
    "manual_rsp_y_m": {
      "type": "number",
      "description": "Explicit RSP Y position in meters when rsp_mode is manual_position. Null = not set.",
      "nullable": true
    },
    "manual_rsp_x_m": {
      "type": "number",
      "description": "Explicit RSP X position in meters when rsp_mode is manual_position. Null = use room centreline.",
      "nullable": true
    },
    "viewing_priority": {
      "type": "string",
      "default": "balanced",
      "description": "Project-scoped multi-row viewing intent. 'balanced' = lexicographic balanced comparator across all rows; dynamic 'row_N' values prioritise row N and are normalised against the current row count at runtime."
    },
    "account_id": {
      "type": "string",
      "description": "ID of the Account this project belongs to"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "Draft",
        "Active",
        "Archived"
      ],
      "default": "Draft",
      "description": "Project lifecycle stage. Archived projects are excluded from the active Projects list but remain fully visible to admin and retain all data, Professional Project status, and CapacityLedger entries."
    },
    "last_age_reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last 200-day age review confirmation (Keep Live). Used to suppress repeat review prompts until 100 further days have elapsed. Null = no prior review.",
      "nullable": true
    },
    "commercial_tier": {
      "type": "string",
      "enum": [
        "UNCLASSIFIED",
        "FREE",
        "PROFESSIONAL",
        "INTERNAL"
      ],
      "default": "UNCLASSIFIED",
      "description": "Commercial classification of this project. UNCLASSIFIED = existing/pre-B1 projects (no change in behaviour). FREE / PROFESSIONAL / INTERNAL assigned by future commercial enforcement. Not enforced in Stage B1 \u2014 projects remain fully editable regardless of value."
    },
    "professional_activated_date": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when this project was activated as a Professional project (consumed capacity via PROJECT_ACTIVATION ledger entry). Null = not yet activated. Not set automatically in Stage B1.",
      "nullable": true
    },
    "activation_ledger_entry_id": {
      "type": "string",
      "description": "ID of the CapacityLedger record that activated this project (delta=-1). Null = not yet activated. Links the project to its commercial consumption record.",
      "nullable": true
    },
    "commercial_source": {
      "type": "string",
      "description": "Source of the commercial classification (e.g. 'TRIAL', 'PURCHASED', 'UK_TURNOVER_REWARD', 'DISTRIBUTOR_ALLOCATION', 'ADMIN_GRANT', 'PROMOTION'). Informational \u2014 mirrors the ledger transaction type that granted the capacity consumed by this project. 'PROMOTION' indicates the project was created under an active UNLIMITED_PRO_PROJECTS promotion and consumed no banked capacity."
    },
    "promotion_id": {
      "type": "string",
      "nullable": true,
      "description": "ID of the Promotion that entitled this project's creation. Null for normal capacity-consumed projects. Set only when the project was created under an active UNLIMITED_PRO_PROJECTS promotion. Promotional projects have commercial_tier=PROFESSIONAL, commercial_source='PROMOTION', activation_ledger_entry_id=null (no PROJECT_ACTIVATION ledger entry)."
    },
    "metrics_last_opened": {
      "type": "string",
      "format": "date-time",
      "description": "Analytics only \u2014 last time this project was opened. Not wired to any tracking yet."
    },
    "metrics_last_modified": {
      "type": "string",
      "format": "date-time",
      "description": "Analytics only \u2014 last time this project was modified. Not wired to any tracking yet."
    },
    "metrics_session_count": {
      "type": "number",
      "default": 0,
      "description": "Analytics only \u2014 number of sessions. Not wired to any tracking yet."
    },
    "metrics_total_minutes_used": {
      "type": "number",
      "default": 0,
      "description": "Analytics only \u2014 total minutes used. Not wired to any tracking yet."
    },
    "metrics_reports_generated": {
      "type": "number",
      "default": 0,
      "description": "Analytics only \u2014 number of reports generated. Not wired to any tracking yet."
    },
    "metrics_bass_simulations_run": {
      "type": "number",
      "default": 0,
      "description": "Analytics only \u2014 number of bass simulations run. Not wired to any tracking yet."
    },
    "metrics_exports": {
      "type": "number",
      "default": 0,
      "description": "Analytics only \u2014 number of exports. Not wired to any tracking yet."
    },
    "acoustic_treatment_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether acoustic treatment (Artcoustic Abfuser) is enabled for this project."
    },
    "selected_abfuser_qty": {
      "type": "number",
      "default": 0,
      "description": "Designer-selected Abfuser quantity. Drives System Price and RP22 Products Selected. 0 when acoustic treatment is off."
    },
    "abfuser_qty_source": {
      "type": "string",
      "enum": [
        "recommended",
        "user"
      ],
      "default": "recommended",
      "description": "Whether selected_abfuser_qty was auto-seeded from the recommendation ('recommended') or manually set by the designer ('user'). When 'recommended', the selected quantity auto-follows recommendation changes."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}