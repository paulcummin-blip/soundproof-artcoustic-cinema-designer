{
  "name": "SpeakerProduct",
  "type": "object",
  "description": "One record per loudspeaker product in the Speaker Database. Contains product identity, category (physical form), role, status, images, and links. Specifications live in SpeakerSpecification (one-to-one via current_specification_id, designed for one-to-many versioning in the future). This is the single source of truth for product identity \u2014 specification data changes over time, product identity does not. The database knows nothing about RP22; capability is derived downstream by the RP22 engine.",
  "properties": {
    "manufacturer_id": {
      "type": "string",
      "description": "ID of the SpeakerManufacturer this product belongs to."
    },
    "manufacturer_name": {
      "type": "string",
      "description": "Denormalized manufacturer name for display without joins."
    },
    "series": {
      "type": "string",
      "description": "Product series name (e.g. '800 Diamond', 'Reference')"
    },
    "model": {
      "type": "string",
      "description": "Model name/number (e.g. '802 D4', 'SP-2-8')"
    },
    "full_product_name": {
      "type": "string",
      "description": "Full display name including manufacturer, series, and model."
    },
    "category": {
      "type": "string",
      "enum": [
        "On Wall",
        "In Wall",
        "Freestanding",
        "Other"
      ],
      "default": "Other",
      "description": "Physical category / form factor. Describes how the product is mounted or installed, NOT its role. Role is a separate field."
    },
    "role": {
      "type": "string",
      "enum": [
        "LCR",
        "Surround",
        "Both",
        "Wide",
        "Height",
        "Flexible"
      ],
      "default": "Flexible",
      "description": "Speaker role. 'Both' = can be used as LCR or Surround. 'Flexible' = fits multiple roles (e.g. Artcoustic, Triad). Separate from category which describes physical form."
    },
    "status": {
      "type": "string",
      "enum": [
        "Current",
        "Discontinued",
        "Coming Soon",
        "Hidden",
        "Archived",
        "Unknown"
      ],
      "default": "Unknown",
      "description": "Product lifecycle status. 'Hidden' = suppressed from selectors but retained in database. 'Archived' = long-term retained, excluded from active views."
    },
    "official_product_url": {
      "type": "string",
      "description": "Official manufacturer product page URL."
    },
    "official_pdf_url": {
      "type": "string",
      "description": "Official manufacturer specification PDF URL."
    },
    "hero_image_url": {
      "type": "string",
      "description": "Hero product image URL for comparison pages and detail headers.",
      "nullable": true
    },
    "thumbnail_image_url": {
      "type": "string",
      "description": "Small thumbnail image URL for list views and cards.",
      "nullable": true
    },
    "diagram_image_url": {
      "type": "string",
      "description": "Technical diagram / cutaway image URL for engineering views.",
      "nullable": true
    },
    "current_specification_id": {
      "type": "string",
      "description": "ID of the current SpeakerSpecification record. One-to-one link today. Null = no specification created yet. When versioned specifications are introduced, this pointer selects the active version.",
      "nullable": true
    },
    "notes": {
      "type": "string",
      "description": "Internal notes about this product."
    }
  },
  "required": [
    "manufacturer_id",
    "model"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}