{
  "name": "Proposal",
  "type": "object",
  "description": "A client-facing design proposal for a project. One proposal per project version. Created via a wizard that selects a project version and Narrative Goal, then generates a complete first draft via GPT. The Proposal Editor is the primary workspace for reviewing, editing, and approving proposals before export.",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID of the Project this proposal belongs to."
    },
    "account_id": {
      "type": "string",
      "description": "Denormalized account_id from the parent Project, used for RLS."
    },
    "version_id": {
      "type": "string",
      "description": "ID of the ProjectVersion this proposal is based on. One proposal per version.",
      "nullable": true
    },
    "title": {
      "type": "string",
      "description": "Proposal title (defaults to project name).",
      "default": "Untitled Proposal"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "generating",
        "generated",
        "reviewed",
        "sent",
        "archived"
      ],
      "default": "draft",
      "description": "Proposal lifecycle status. draft = created but not yet generated. generating = GPT generation in progress. generated = GPT content populated. reviewed = human-reviewed. sent = delivered to client. archived = retired."
    },
    "narrative_goal": {
      "type": "string",
      "enum": [
        "luxury_cinema",
        "family_media_room",
        "reference_performance",
        "best_value",
        "future_proof"
      ],
      "default": "luxury_cinema",
      "description": "The proposal's personality. First thing GPT reads. luxury_cinema = premium home cinema experience, family_media_room = accessible family entertainment, reference_performance = audiophile-grade accuracy, best_value = cost-conscious quality, future_proof = investment in upgradeability."
    },
    "narrative_brief": {
      "type": "string",
      "description": "Auto-generated narrative brief derived from the Narrative Goal. Can be regenerated by changing the goal. Guides GPT generation tone and emphasis.",
      "nullable": true
    },
    "proposal_date": {
      "type": "string",
      "format": "date",
      "description": "Date the proposal was issued.",
      "nullable": true
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Proposal version number for future versioning."
    },
    "template": {
      "type": "string",
      "description": "Template identifier for this proposal. References a future template definition from the Proposal Centre Templates tab. Null = use default template.",
      "nullable": true
    },
    "metadata": {
      "type": "object",
      "description": "Hidden proposal metadata supplied to GPT during generation. Includes audience, word count, language, tone. Dealer never sees this in the exported proposal.",
      "properties": {
        "audience": {
          "type": "string",
          "description": "Target audience for the proposal (e.g. homeowner, architect, developer).",
          "nullable": true
        },
        "word_count": {
          "type": "string",
          "enum": [
            "concise",
            "standard",
            "detailed"
          ],
          "default": "standard",
          "nullable": true
        },
        "language": {
          "type": "string",
          "default": "en-GB",
          "nullable": true
        },
        "tone": {
          "type": "string",
          "default": "professional",
          "nullable": true
        }
      }
    }
  },
  "required": [
    "project_id",
    "account_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}