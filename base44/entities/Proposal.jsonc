{
  "name": "Proposal",
  "type": "object",
  "description": "A client-facing design report with frozen per-version comparison evidence.",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID of the parent Project."
    },
    "account_id": {
      "type": "string",
      "description": "Denormalized parent account for RLS."
    },
    "creation_request_id": {
      "type": "string",
      "nullable": true,
      "description": "Creation idempotency key; never copied on duplication."
    },
    "proposal_type": {
      "type": "string",
      "enum": [
        "single",
        "comparison",
        "system_summary"
      ],
      "default": "single"
    },
    "selected_version_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Exact version IDs in comparison column order."
    },
    "version_id": {
      "type": "string",
      "nullable": true
    },
    "title": {
      "type": "string",
      "default": "Untitled Proposal"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "generating",
        "generated",
        "edited",
        "reviewed",
        "issued",
        "accepted",
        "sent",
        "archived"
      ],
      "default": "draft"
    },
    "previous_status": {
      "type": "string",
      "enum": [
        "draft",
        "generating",
        "generated",
        "edited",
        "reviewed",
        "issued",
        "accepted",
        "sent"
      ],
      "nullable": true
    },
    "narrative_goal": {
      "type": "string",
      "enum": [
        "luxury_cinema",
        "family_media_room",
        "reference_performance",
        "best_value",
        "future_proof"
      ],
      "default": "luxury_cinema"
    },
    "client_brief": {
      "type": "string",
      "nullable": true,
      "description": "Narrative emphasis only, never changes engineering."
    },
    "narrative_brief": {
      "type": "string",
      "nullable": true
    },
    "proposal_date": {
      "type": "string",
      "format": "date",
      "nullable": true
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "version_label": {
      "type": "string",
      "nullable": true
    },
    "is_current_version": {
      "type": "boolean",
      "default": true
    },
    "parent_proposal_id": {
      "type": "string",
      "nullable": true
    },
    "template": {
      "type": "string",
      "nullable": true
    },
    "engineering_snapshot": {
      "type": "object",
      "nullable": true,
      "description": "Frozen primary engineering snapshot."
    },
    "metadata": {
      "type": "object",
      "description": "Narrative settings and durable frozen comparison contract.",
      "properties": {
        "audience": {
          "type": "string",
          "nullable": true
        },
        "word_count": {
          "type": "string",
          "enum": [
            "concise",
            "standard",
            "detailed"
          ],
          "default": "standard",
          "nullable": true
        },
        "language": {
          "type": "string",
          "default": "en-GB",
          "nullable": true
        },
        "tone": {
          "type": "string",
          "default": "professional",
          "nullable": true
        },
        "project_interpretation": {
          "type": "object",
          "additionalProperties": true
        },
        "comparison_reading": {
          "type": "object",
          "additionalProperties": true
        },
        "selected_versions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "comparison_table": {
          "type": "object",
          "properties": {
            "versions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "version_id": {
                    "type": "string",
                    "nullable": true
                  },
                  "version_name": {
                    "type": "string",
                    "nullable": true
                  },
                  "label": {
                    "type": "string"
                  },
                  "source_identity": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Frozen project/version identity and available source fingerprints; never inferred."
                  }
                }
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "area": {
                    "type": "string"
                  },
                  "values": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "identical": {
                    "type": "boolean"
                  },
                  "change": {
                    "type": "string",
                    "nullable": true
                  },
                  "client_meaning": {
                    "type": "string",
                    "description": "Evidence-scoped deterministic explanation."
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "project_id",
    "account_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}