{
  "name": "Proposal",
  "type": "object",
  "description": "A client-facing design proposal for a project. Created via a wizard that selects a project, proposal type, one or more project versions, and a Client Brief & Narrative Focus, then generates a complete first draft. The Proposal Editor is the primary workspace for reviewing, editing, and approving proposals before export.",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID of the Project this proposal belongs to."
    },
    "account_id": {
      "type": "string",
      "description": "Denormalized account_id from the parent Project, used for RLS."
    },
    "proposal_type": {
      "type": "string",
      "enum": [
        "single",
        "comparison"
      ],
      "default": "single",
      "description": "The type of proposal document. 'single' = a proposal for one design version. 'comparison' = a side-by-side comparison of two or more design versions. This determines which Proposal Intelligence pipeline is executed. Designed to support additional types in the future (e.g. product, upgrade, commercial, technical) without schema changes."
    },
    "selected_version_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Array of ProjectVersion IDs this proposal is based on. For 'single' proposals, exactly one version. For 'comparison' proposals, two or more versions. Future Proposal Intelligence receives all selected versions rather than assuming only one exists."
    },
    "version_id": {
      "type": "string",
      "description": "Legacy field \u2014 the single ProjectVersion ID this proposal was based on. Superseded by selected_version_ids for new proposals. Retained for backward compatibility; for new 'single' proposals this is set to selected_version_ids[0].",
      "nullable": true
    },
    "title": {
      "type": "string",
      "description": "Proposal title (defaults to project name).",
      "default": "Untitled Proposal"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "generating",
        "generated",
        "edited",
        "reviewed",
        "issued",
        "accepted",
        "sent",
        "archived"
      ],
      "default": "draft",
      "description": "Proposal lifecycle status. Content-generation states: draft = created but not yet generated. generating = AI generation in progress. generated = initial AI output complete. Business lifecycle states: edited = manually reviewed or modified by the designer. reviewed = legacy equivalent of edited (retained for backward compatibility). issued = client-facing proposal sent or published. sent = legacy equivalent of issued (retained for backward compatibility). accepted = client accepted the proposal. archived = completed or closed. Full lifecycle: Draft \u2192 Generating \u2192 Generated \u2192 Edited \u2192 Issued \u2192 Accepted \u2192 Archived."
    },
    "previous_status": {
      "type": "string",
      "enum": [
        "draft",
        "generating",
        "generated",
        "edited",
        "reviewed",
        "issued",
        "accepted",
        "sent"
      ],
      "description": "The lifecycle status before this proposal was archived. Set by the server-authoritative transition function when archiving. Used to restore the proposal to its previous status on unarchive. Null = never archived or already restored.",
      "nullable": true
    },
    "narrative_goal": {
      "type": "string",
      "enum": [
        "luxury_cinema",
        "family_media_room",
        "reference_performance",
        "best_value",
        "future_proof"
      ],
      "default": "luxury_cinema",
      "description": "Legacy narrative personality selector. Superseded by client_brief for new proposals. Retained for backward compatibility with existing proposals. No longer shown in the wizard UI."
    },
    "client_brief": {
      "type": "string",
      "description": "Client Brief & Narrative Focus \u2014 free-text guidance that shapes the narrative emphasis, wording, and structure of the generated proposal. Influences narrative only; never alters engineering results, RP22 values, Design Ratings, or recommendations. Preloaded on regeneration so the user can refine rather than rewrite.",
      "nullable": true
    },
    "narrative_brief": {
      "type": "string",
      "description": "Auto-generated narrative brief derived from the Narrative Goal. Can be regenerated by changing the goal. Guides GPT generation tone and emphasis.",
      "nullable": true
    },
    "proposal_date": {
      "type": "string",
      "format": "date",
      "description": "Date the proposal was issued.",
      "nullable": true
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Proposal version number for future versioning."
    },
    "version_label": {
      "type": "string",
      "description": "Independent proposal version label for proposal versioning (e.g. 'Proposal A', 'Revision 1', 'Final'). Null = not yet versioned. Each project may have multiple proposals with different version labels. Only one proposal per project can have is_current_version = true.",
      "nullable": true
    },
    "is_current_version": {
      "type": "boolean",
      "default": true,
      "description": "Whether this is the current active version among proposals linked to the same project. Only one proposal per project should have this set to true. Previous versions remain read-only for audit and comparison."
    },
    "parent_proposal_id": {
      "type": "string",
      "description": "ID of the parent Proposal this proposal is a revision of. Null = this is an original proposal, not a revision. Links proposals in a version chain within the same project.",
      "nullable": true
    },
    "template": {
      "type": "string",
      "description": "Template identifier for this proposal. References a future template definition from the Proposal Centre Templates tab. Null = use default template.",
      "nullable": true
    },
    "engineering_snapshot": {
      "type": "object",
      "description": "Frozen Engineering Snapshot assembled at proposal generation time from the SAME canonical authorities used by Room Designer / Compliance / Design Rating. Contains version-locked engineering truth: identity (projectId, versionId, engineeringFingerprint, calculationRevision), room, seats, system, RP22 (overall, category floors, DPI, parameter headlines, assumed), bass (P14/P18/P19/P20 with per-seat and scoped floors), viewing/RP23, products, pricing, constraints. Later Room Designer edits do NOT silently change an existing proposal \u2014 the snapshot is frozen at generation time. A future regeneration creates/updates a new snapshot explicitly. Null for proposals generated before Stage 2A.",
      "nullable": true
    },
    "metadata": {
      "type": "object",
      "description": "Hidden proposal metadata supplied to GPT during generation. Includes audience, word count, language, tone. Dealer never sees this in the exported proposal.",
      "properties": {
        "audience": {
          "type": "string",
          "description": "Target audience for the proposal (e.g. homeowner, architect, developer).",
          "nullable": true
        },
        "word_count": {
          "type": "string",
          "enum": [
            "concise",
            "standard",
            "detailed"
          ],
          "default": "standard",
          "nullable": true
        },
        "language": {
          "type": "string",
          "default": "en-GB",
          "nullable": true
        },
        "tone": {
          "type": "string",
          "default": "professional",
          "nullable": true
        }
      }
    }
  },
  "required": [
    "project_id",
    "account_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}