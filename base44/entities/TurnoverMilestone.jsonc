{
  "name": "TurnoverMilestone",
  "type": "object",
  "description": "Admin-only reconciliation state for one annual UK turnover reward threshold. CapacityLedger remains the append-only commercial authority; this entity records the latest state and links its award/reversal history.",
  "properties": {
    "account_id": {
      "type": "string",
      "description": "ID of the Sound Proof Account this milestone belongs to."
    },
    "calendar_year": {
      "type": "number",
      "description": "Calendar year this entitlement applies to."
    },
    "milestone_value_gbp": {
      "type": "number",
      "description": "Earned reward threshold represented by this state record."
    },
    "reward_projects": {
      "type": "number",
      "description": "Professional Projects represented by the threshold."
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "REVERSED"
      ],
      "default": "ACTIVE",
      "description": "Latest reconciled threshold state. History remains in CapacityLedger."
    },
    "reward_ledger_entry_id": {
      "type": "string",
      "description": "ID of the first CapacityLedger reward entry for this threshold.",
      "nullable": true
    },
    "reversal_ledger_entry_id": {
      "type": "string",
      "description": "ID of the latest explicit reversal for this threshold.",
      "nullable": true
    },
    "latest_ledger_entry_id": {
      "type": "string",
      "description": "ID of the latest award, reinstatement, or reversal event.",
      "nullable": true
    },
    "reversal_count": {
      "type": "number",
      "default": 0,
      "description": "Number of explicit reversals appended for this threshold."
    },
    "reinstatement_count": {
      "type": "number",
      "default": 0,
      "description": "Number of times this threshold was re-earned after reversal."
    },
    "source_calculated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When Lovable calculated the entitlement contract used for the latest reconciliation.",
      "nullable": true
    },
    "last_reconciled_at": {
      "type": "string",
      "format": "date-time",
      "description": "When Sound Proof last changed this threshold state.",
      "nullable": true
    },
    "source_turnover_gbp": {
      "type": "number",
      "description": "Legacy admin-only source field retained for old records. The current minimal contract never writes raw turnover.",
      "nullable": true
    }
  },
  "required": [
    "account_id",
    "calendar_year",
    "milestone_value_gbp",
    "reward_projects"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}