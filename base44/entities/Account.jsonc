{
  "name": "Account",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Account name"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "trial",
        "suspended"
      ],
      "default": "active",
      "description": "Account status. inactive = Not Activated (administrator has not enabled Sound Proof access). active = Enabled (administrator has explicitly activated the account). suspended = Suspended (administrator has suspended access). Only the manageSoundProofAccess backend function may change this for Premium Partner accounts; login, invitation acceptance, legacy linking and Portal SSO must never auto-enable an inactive account."
    },
    "soundproof_eligible": {
      "type": "boolean",
      "default": false,
      "description": "Sound Proof activation eligibility. Set to true by Sound Proof Admin to make a dealer eligible for Portal-first activation. Does NOT start the 90-day term, set account status to active, or enable any user. The 90-day term starts only on successful first-user account claim from the Partner Portal. Separate from status (active/inactive/suspended) and from soundproof_access_expires_at. Only the manageSoundProofAccess backend function may change this."
    },
    "rs_approval_status": {
      "type": "string",
      "enum": [
        "awaiting_approval",
        "approved",
        "suspended"
      ],
      "default": "awaiting_approval",
      "description": "RS-01 Richer Sounds internal approval. A SECOND, separate approval dimension from soundproof_eligible: soundproof_eligible remains the sole Sound Proof Master Admin approval; rs_approval_status is the internal RS approval set by a Master Admin or an authorised Custom Install - 93 administrator on ordinary Richer Sounds stores. awaiting_approval = not yet RS approved (the honest default for the 52 ordinary RS accounts that predate this field; never silently promoted). approved = RS approved. suspended = RS approval withdrawn. Only ordinary RICHER_SOUNDS accounts (NOT Custom Install - 93) carry this field; 93 is exempt and the dual-approval gate skips it. An ordinary Richer Sounds store can activate and use Sound Proof only when soundproof_eligible is true AND rs_approval_status is approved. Only the manageRicherSoundsApproval backend function may change this. Defaults to awaiting_approval; existing records are NOT bulk-rewritten \u2014 a missing value reads as awaiting_approval."
    },
    "rs_approval_set_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "When rs_approval_status was most recently set (approved, suspended, or restored to approved). Null while the field has never been set (the account is still in its default awaiting_approval state). Set by manageRicherSoundsApproval on every transition."
    },
    "rs_approval_set_by": {
      "type": "string",
      "nullable": true,
      "description": "Name or email of the administrator who most recently set rs_approval_status. Null while never set. Set by manageRicherSoundsApproval."
    },
    "contact_email": {
      "type": "string",
      "description": "Primary contact email"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "dealer",
        "distributor",
        "client",
        "admin",
        "demo",
        "internal",
        "professional"
      ],
      "default": "dealer",
      "description": "Account type. distributor = international distributor that allocates capacity to child dealer accounts; internal = Sound Proof internal organisation; professional = non-dealer professional user (cinema designers/specifiers) with Sound Proof access but no dealer page, trade pricing, or turnover tracking."
    },
    "dealer_group": {
      "type": "string",
      "enum": [
        "PREMIUM_PARTNER",
        "RICHER_SOUNDS",
        "OTHER_DEALER",
        "INTERNATIONAL",
        "INTERNAL",
        "PROFESSIONAL"
      ],
      "description": "Commercial grouping for Admin presentation (Premium Partners, Richer Sounds, Other Dealers, International, Internal, Professional). Separate from account_type which describes the organisation role (dealer/distributor/etc)."
    },
    "parent_account_id": {
      "type": "string",
      "description": "ID of the parent Account. For dealer accounts under an international distributor, this is the distributor Account.id. UK dealers may have no parent (null).",
      "nullable": true
    },
    "territory": {
      "type": "string",
      "description": "Territory code for this account (e.g. UK, IE, IN, DE, AU, US). Free-form string to allow future territories without schema changes."
    },
    "notes": {
      "type": "string",
      "description": "Internal admin notes"
    },
    "last_access_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last access timestamp"
    },
    "project_count": {
      "type": "number",
      "default": 0,
      "description": "Number of projects linked to this account"
    },
    "soundproof_access_expires_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "Sound Proof access expiry timestamp. Set by explicit administrator activation to now + 90 days. When this time has passed the dealer sees a Renew Access screen. Null = no term set (account has not been activated through the new enable flow, or is not subject to the 90-day term). Separate from administrator suspension: renewal may extend this date but never clears a manual suspension."
    },
    "first_activated_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "Canonical first-activation timestamp (write-once). Set ONLY on the first confirmed Sound Proof account activation: an admin enable (manageSoundProofAccess enable) or the first Portal-verified user claim that starts the 90-day term (startSoundProofTermOnFirstClaim). Never set or changed by renewal, suspend or restore. An identity claim alone (PORTAL_IDENTITY_CLAIMED) does NOT set it. Set through setFirstActivatedAtIfUnset (conditional updateMany, first_activated_at: null -> timestamp) so a concurrent activation cannot overwrite an existing date. Existing accounts without reliable historical evidence retain null (unknown) rather than an inferred date. The three-month introductory promotion is NOT granted from this date yet."
    },
    "creation_lock_holder": {
      "type": "string",
      "nullable": true,
      "description": "Internal per-account creation-lock holder token. Null = free; a non-null value = a Professional Project creation is in progress for this account. Acquired and released only by createProfessionalProject via a single-record conditional updateMany (creation_lock_holder: null -> token), which the platform rechecks at write time. Serializes Professional Project creation per account so the non-atomic capacity-check-then-deduct sequence cannot interleave across concurrent requests. There is NO time-based takeover: a lock held by a still-running or crashed request stays held until released or admin force-released (reconcileProjectCreation). Not a business field: it never affects balances, status, eligibility, expiry or access, and is never read by any dealer-facing surface."
    },
    "creation_lock_held_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "Timestamp the creation lock was acquired. Diagnostic only (never used for automatic takeover). Null when the lock is free. Not a business field."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "id": "{{user.data.account_id}}"
            },
            {
              "id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "user_condition": {
                "data.access_level": "FULL_ACCESS"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}