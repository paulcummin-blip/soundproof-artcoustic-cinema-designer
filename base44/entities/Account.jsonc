{
  "name": "Account",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Account name"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "trial",
        "suspended"
      ],
      "default": "active",
      "description": "Account status. inactive = Not Activated (administrator has not enabled Sound Proof access). active = Enabled (administrator has explicitly activated the account). suspended = Suspended (administrator has suspended access). Only the manageSoundProofAccess backend function may change this for Premium Partner accounts; login, invitation acceptance, legacy linking and Portal SSO must never auto-enable an inactive account."
    },
    "soundproof_eligible": {
      "type": "boolean",
      "default": false,
      "description": "Sound Proof activation eligibility. Set to true by Sound Proof Admin to make a dealer eligible for Portal-first activation. Does NOT start the 90-day term, set account status to active, or enable any user. The 90-day term starts only on successful first-user account claim from the Partner Portal. Separate from status (active/inactive/suspended) and from soundproof_access_expires_at. Only the manageSoundProofAccess backend function may change this."
    },
    "contact_email": {
      "type": "string",
      "description": "Primary contact email"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "dealer",
        "distributor",
        "client",
        "admin",
        "demo",
        "internal",
        "professional"
      ],
      "default": "dealer",
      "description": "Account type. distributor = international distributor that allocates capacity to child dealer accounts; internal = Sound Proof internal organisation; professional = non-dealer professional user (cinema designers/specifiers) with Sound Proof access but no dealer page, trade pricing, or turnover tracking."
    },
    "dealer_group": {
      "type": "string",
      "enum": [
        "PREMIUM_PARTNER",
        "RICHER_SOUNDS",
        "OTHER_DEALER",
        "INTERNATIONAL",
        "INTERNAL",
        "PROFESSIONAL"
      ],
      "description": "Commercial grouping for Admin presentation (Premium Partners, Richer Sounds, Other Dealers, International, Internal, Professional). Separate from account_type which describes the organisation role (dealer/distributor/etc)."
    },
    "parent_account_id": {
      "type": "string",
      "description": "ID of the parent Account. For dealer accounts under an international distributor, this is the distributor Account.id. UK dealers may have no parent (null).",
      "nullable": true
    },
    "territory": {
      "type": "string",
      "description": "Territory code for this account (e.g. UK, IE, IN, DE, AU, US). Free-form string to allow future territories without schema changes."
    },
    "notes": {
      "type": "string",
      "description": "Internal admin notes"
    },
    "last_access_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last access timestamp"
    },
    "project_count": {
      "type": "number",
      "default": 0,
      "description": "Number of projects linked to this account"
    },
    "soundproof_access_expires_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "Sound Proof access expiry timestamp. Set by explicit administrator activation to now + 90 days. When this time has passed the dealer sees a Renew Access screen. Null = no term set (account has not been activated through the new enable flow, or is not subject to the 90-day term). Separate from administrator suspension: renewal may extend this date but never clears a manual suspension."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "id": "{{user.data.account_id}}"
            },
            {
              "id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "user_condition": {
                "data.access_level": "FULL_ACCESS"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}