{
  "name": "Account",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Account name"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "trial",
        "suspended"
      ],
      "default": "active",
      "description": "Account status"
    },
    "contact_email": {
      "type": "string",
      "description": "Primary contact email"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "dealer",
        "distributor",
        "client",
        "admin",
        "demo",
        "internal",
        "professional"
      ],
      "default": "dealer",
      "description": "Account type. distributor = international distributor that allocates capacity to child dealer accounts; internal = Sound Proof internal organisation; professional = non-dealer professional user (cinema designers/specifiers) with Sound Proof access but no dealer page, trade pricing, or turnover tracking."
    },
    "dealer_group": {
      "type": "string",
      "enum": [
        "PREMIUM_PARTNER",
        "RICHER_SOUNDS",
        "OTHER_DEALER",
        "INTERNATIONAL",
        "INTERNAL",
        "PROFESSIONAL"
      ],
      "description": "Commercial grouping for Admin presentation (Premium Partners, Richer Sounds, Other Dealers, International, Internal, Professional). Separate from account_type which describes the organisation role (dealer/distributor/etc)."
    },
    "parent_account_id": {
      "type": "string",
      "description": "ID of the parent Account. For dealer accounts under an international distributor, this is the distributor Account.id. UK dealers may have no parent (null).",
      "nullable": true
    },
    "territory": {
      "type": "string",
      "description": "Territory code for this account (e.g. UK, IE, IN, DE, AU, US). Free-form string to allow future territories without schema changes."
    },
    "notes": {
      "type": "string",
      "description": "Internal admin notes"
    },
    "last_access_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last access timestamp"
    },
    "project_count": {
      "type": "number",
      "default": 0,
      "description": "Number of projects linked to this account"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "id": "{{user.data.account_id}}"
            },
            {
              "id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "user_condition": {
                "data.access_level": "FULL_ACCESS"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}