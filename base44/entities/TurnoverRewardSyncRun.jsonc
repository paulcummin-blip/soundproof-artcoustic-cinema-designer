{
  "name": "TurnoverRewardSyncRun",
  "type": "object",
  "description": "Audit log for UK turnover reward sync runs. One row per execution of syncUkTurnoverRewards. This is an audit trail, NOT a balance authority \u2014 CapacityLedger remains the sole commercial authority. Admin-only access.",
  "properties": {
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the sync run started."
    },
    "finished_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the sync run finished. Null while RUNNING.",
      "nullable": true
    },
    "calendar_year": {
      "type": "number",
      "description": "Calendar year this sync run processed (e.g. 2026)."
    },
    "source_last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "The most recent source_last_updated timestamp observed across all dealer rows in this run. Used for staleness detection.",
      "nullable": true
    },
    "status": {
      "type": "string",
      "enum": [
        "RUNNING",
        "DRY_RUN",
        "SUCCESS",
        "PARTIAL",
        "FAILED"
      ],
      "description": "RUNNING = in progress; DRY_RUN = dry run completed (zero commercial writes); SUCCESS = all dealers processed; PARTIAL = some rows skipped due to errors; FAILED = aborted before processing."
    },
    "dealers_received": {
      "type": "number",
      "default": 0,
      "description": "Total dealer rows received from the Partner Portal bridge."
    },
    "dealers_matched": {
      "type": "number",
      "default": 0,
      "description": "Dealer rows that matched a Sound Proof Account via canonical ExternalAccountLink."
    },
    "dealers_unmatched": {
      "type": "number",
      "default": 0,
      "description": "Dealer rows with no matching Sound Proof Account or canonical link."
    },
    "dealers_updated": {
      "type": "number",
      "default": 0,
      "description": "TurnoverRecord rows upserted (created or updated) in this run. Zero in dry run."
    },
    "milestones_awarded": {
      "type": "number",
      "default": 0,
      "description": "Number of TurnoverMilestone records created (and CapacityLedger UK_TURNOVER_REWARD entries appended) in this run. Zero in dry run."
    },
    "projects_awarded": {
      "type": "number",
      "default": 0,
      "description": "Total Professional Projects credited in this run = milestones_awarded \u00d7 5. Zero in dry run."
    },
    "discrepancy_count": {
      "type": "number",
      "default": 0,
      "description": "Number of dealers whose turnover decreased since the last sync (credit note / correction / return). Earned projects are NOT reversed; the discrepancy is flagged for admin review."
    },
    "error_count": {
      "type": "number",
      "default": 0,
      "description": "Number of dealer rows skipped due to invalid data (missing partner_user_id, non-numeric turnover, etc.)."
    },
    "error_summary": {
      "type": "string",
      "description": "Concatenated summary of row-level errors and discrepancies for admin review."
    },
    "dry_run": {
      "type": "boolean",
      "default": false,
      "description": "True if this run was a dry run (zero commercial writes). The sync run record itself is the only write in dry-run mode."
    }
  },
  "required": [
    "calendar_year",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}