{
  "name": "TurnoverRewardSyncRun",
  "type": "object",
  "description": "Admin-only audit log for the nightly Lovable entitlement reconciliation. CapacityLedger remains the append-only commercial authority.",
  "properties": {
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the reconciliation started."
    },
    "finished_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the reconciliation finished. Null while RUNNING.",
      "nullable": true
    },
    "calendar_year": {
      "type": "number",
      "description": "Calendar year reconciled."
    },
    "contract_version": {
      "type": "number",
      "description": "Version of the minimal entitlement contract accepted from Lovable."
    },
    "source_last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "Lovable contract calculated_at timestamp.",
      "nullable": true
    },
    "status": {
      "type": "string",
      "enum": [
        "RUNNING",
        "DRY_RUN",
        "SUCCESS",
        "PARTIAL",
        "FAILED"
      ],
      "description": "RUNNING while active; DRY_RUN when a no-commercial-write validation completed; SUCCESS when all matched rows reconciled; PARTIAL when individual rows failed; FAILED when the run failed closed."
    },
    "dealers_received": {
      "type": "number",
      "default": 0,
      "description": "Stable dealer IDs received in the minimal contract."
    },
    "dealers_matched": {
      "type": "number",
      "default": 0,
      "description": "Dealer IDs matched through an active canonical ExternalAccountLink."
    },
    "dealers_unmatched": {
      "type": "number",
      "default": 0,
      "description": "Dealer IDs with no active canonical Sound Proof link. They are skipped and never treated as zero entitlement."
    },
    "dealers_updated": {
      "type": "number",
      "default": 0,
      "description": "Matched dealers whose append-only ledger changed."
    },
    "dealers_reconciled": {
      "type": "number",
      "default": 0,
      "description": "Matched dealers successfully checked, including no-op reconciliations."
    },
    "milestones_awarded": {
      "type": "number",
      "default": 0,
      "description": "New threshold reward or reinstatement ledger events appended."
    },
    "projects_awarded": {
      "type": "number",
      "default": 0,
      "description": "Professional Project credits appended by new rewards."
    },
    "milestones_reversed": {
      "type": "number",
      "default": 0,
      "description": "No-longer-earned thresholds corrected through explicit reversal events."
    },
    "projects_reversed": {
      "type": "number",
      "default": 0,
      "description": "Professional Project credits removed by explicit reversal events. Completed project consumption is never reversed."
    },
    "milestones_reinstated": {
      "type": "number",
      "default": 0,
      "description": "Previously reversed thresholds re-earned and explicitly reinstated."
    },
    "projects_reinstated": {
      "type": "number",
      "default": 0,
      "description": "Professional Project credits restored by reinstatement events."
    },
    "discrepancy_count": {
      "type": "number",
      "default": 0,
      "description": "Ledger-state inconsistencies or contract rows that could not be safely reconciled."
    },
    "error_count": {
      "type": "number",
      "default": 0,
      "description": "Contract or dealer rows rejected or skipped for safety."
    },
    "error_summary": {
      "type": "string",
      "description": "Admin-only concise error and reconciliation notes."
    },
    "dry_run": {
      "type": "boolean",
      "default": false,
      "description": "True when the run validated and planned actions without writing CapacityLedger or TurnoverMilestone."
    }
  },
  "required": [
    "calendar_year",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}