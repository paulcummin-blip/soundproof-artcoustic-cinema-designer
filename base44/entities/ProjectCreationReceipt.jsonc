{
  "name": "ProjectCreationReceipt",
  "type": "object",
  "description": "Request-level idempotency receipt for Professional Project creation. One row per (account_id, request_id). Written only by createProfessionalProject, under the per-account creation lock. The stage field tracks the last CONFIRMED write so an interrupted creation is recoverable: PENDING = reserved, no write confirmed; PROJECT_CREATED = the Project write returned (project_id known); LEDGER_CREATED = the CapacityLedger -1 entry confirmed (capacity path); USAGE_CREATED = the PromotionUsage row confirmed (promotional path); COMPLETED = finished and response_payload is replayable to an identical retry; RECONCILING = an uncertain failure where a write may have committed before the response was lost \u2014 never retry blindly, recovery inspects the real Project/Ledger/Usage state. A PENDING/RECONCILING receipt left by a crashed request blocks duplicate creation until reconciled (the safe failure \u2014 no duplicate charge). Internal financial-integrity record, admin-only; never shown to dealers.",
  "properties": {
    "account_id": {
      "type": "string",
      "description": "Account the creation was requested for."
    },
    "request_id": {
      "type": "string",
      "description": "Client-supplied idempotency key for the creation request (UUID). Scoped to account_id, so the same request_id under a different account is a different receipt."
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "COMPLETED"
      ],
      "default": "PENDING",
      "description": "PENDING = creation in flight or interrupted; COMPLETED = finished and response_payload is replayable to an identical retry."
    },
    "stage": {
      "type": "string",
      "enum": [
        "PENDING",
        "PROJECT_CREATED",
        "LEDGER_CREATED",
        "USAGE_CREATED",
        "COMPLETED",
        "RECONCILING"
      ],
      "default": "PENDING",
      "description": "Last CONFIRMED write stage for crash recovery. RECONCILING marks an uncertain failure (a write may have committed) \u2014 never retry blindly; recovery inspects the real Project/Ledger/Usage state and resumes or escalates to admin reconciliation."
    },
    "creation_path": {
      "type": "string",
      "enum": [
        "capacity",
        "promotion"
      ],
      "default": "capacity",
      "description": "Which creation path this receipt is on: capacity (consumes a CapacityLedger -1 entry) or promotion (UNLIMITED_PRO_PROJECTS, no ledger consumption). Set at receipt reservation time from the promotion eligibility lookup. Determines which records recovery inspects."
    },
    "project_id": {
      "type": "string",
      "nullable": true,
      "description": "Created Project id, stamped as soon as the Project write returns (stage PROJECT_CREATED). Null while PENDING. The key recovery uses to fetch and verify the real Project."
    },
    "promotion_id": {
      "type": "string",
      "nullable": true,
      "description": "Promotion id if the project was created under an UNLIMITED_PRO_PROJECTS promotion. Stamped at PROJECT_CREATED on the promotional path. Null for a capacity-consumed project."
    },
    "ledger_entry_id": {
      "type": "string",
      "nullable": true,
      "description": "CapacityLedger entry id for a capacity-consumed project, stamped at LEDGER_CREATED. Null for promotional projects (no ledger consumption)."
    },
    "response_payload": {
      "type": "object",
      "description": "The exact JSON response to replay on a repeated request with the same request_id.",
      "properties": {}
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "When the creation finished. Null while PENDING."
    }
  },
  "required": [
    "account_id",
    "request_id",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}