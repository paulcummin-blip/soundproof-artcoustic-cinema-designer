{
  "name": "Stage2PlacementCache",
  "type": "object",
  "description": "Persistent Stage 2 subwoofer placement canonical evaluation cache. Product-aware, P14-aware canonical P19/P20 ranking of Stage 1 finalists. Clearly separate from Stage 1 placement search, applied-layout canonical authority, and eight-target P14 cache.",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Project identifier owning this Stage 2 placement cache."
    },
    "stage2_cache_version": {
      "type": "integer",
      "description": "Stage 2 cache envelope version.",
      "default": 1
    },
    "stage2_ranking_version": {
      "type": "string",
      "description": "Stage 2 lexicographic ranking algorithm version."
    },
    "stage2_canonical_version": {
      "type": "string",
      "description": "Stage 2 canonical evaluation pipeline version."
    },
    "current_fingerprint": {
      "type": "string",
      "description": "Current Stage 2 fingerprint required by the project."
    },
    "status": {
      "type": "string",
      "enum": [
        "uncalculated",
        "updating",
        "complete"
      ],
      "default": "uncalculated"
    },
    "one_sub_result": {
      "type": "object",
      "description": "Stage 2 result for 1-sub quantity: evaluated finalists, best finalist, ranking, runtime."
    },
    "two_sub_result": {
      "type": "object",
      "description": "Stage 2 result for 2-sub quantity: evaluated finalists, best finalist, ranking, runtime."
    },
    "four_sub_result": {
      "type": "object",
      "description": "Stage 2 result for 4-sub quantity: evaluated finalists, best finalist, ranking, runtime. Includes B last-resort candidate if evaluated."
    },
    "overall_best": {
      "type": "object",
      "description": "Overall best finalist across all quantities, with quantity and family identity."
    },
    "canonical_jobs_run": {
      "type": "integer",
      "description": "Total number of canonical evaluation jobs run for this fingerprint.",
      "default": 0
    },
    "total_runtime_ms": {
      "type": "number",
      "description": "Total Stage 2 wall-clock runtime in milliseconds."
    },
    "b_eligible": {
      "type": "boolean",
      "description": "Whether RP22 B last-resort was eligible for evaluation. True only when all promoted practical four-sub candidates were evaluated and none passed the credibility gate.",
      "default": false
    },
    "b_evaluated": {
      "type": "boolean",
      "description": "Whether RP22 B was actually evaluated through the canonical pipeline. False when B was not eligible or not yet evaluated.",
      "default": false
    },
    "b_eligibility_reason": {
      "type": "string",
      "description": "Reason B became eligible (e.g. 'all_practical_candidates_failed_credibility_gate') or was not eligible (e.g. 'practical_candidate_passes', 'stale_fingerprint').",
      "nullable": true
    },
    "b_failed_candidates": {
      "type": "array",
      "description": "List of practical four-sub candidates that failed the credibility gate, with finalistId, familyId, and failure reason. Empty when B was not eligible or a practical candidate passed.",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "b_result": {
      "type": "object",
      "description": "B canonical evaluation result if evaluated. Same shape as other Stage 2 finalist results. Also included in four_sub_result.evaluatedFinalists. Null when B was not evaluated.",
      "nullable": true
    },
    "placement_fingerprint": {
      "type": "string",
      "description": "P14-independent placement fingerprint for the raw transfer cache. Survives P14 target changes \u2014 only invalidated by physics/source-model changes. Null when no placement has been evaluated.",
      "nullable": true
    },
    "raw_transfers": {
      "type": "object",
      "description": "Persistent P14-independent raw modal transfer cache. Map of finalistId \u2192 rawTransfer object. Keyed by placement_fingerprint. Each rawTransfer contains: { finalistId, familyId, quantity, coordinates, selectedProduct, rspRawCurve, perSeatRawCurves, sources, usableLfHz, transitionHz, seatPriorityMap }. On cold reopen, these are restored to the in-memory cache so P14 switches reuse them without recomputing placement. Null when no raw transfers have been persisted.",
      "nullable": true
    }
  },
  "required": [
    "project_id"
  ]
}