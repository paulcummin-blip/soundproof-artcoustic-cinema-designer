{
  "name": "BrandAsset",
  "type": "object",
  "description": "Global brand assets for a dealer account. One record per account. Stores company identity, logos, hero banner background, contact details, social media, marketing copy (rich text), brand colours, proposal default toggles, and proposal tone. Automatically available to every future proposal generated within this account.",
  "properties": {
    "account_id": {
      "type": "string",
      "description": "ID of the Account these brand assets belong to."
    },
    "company_name": {
      "type": "string",
      "description": "Dealer company name shown on proposals and the hero banner."
    },
    "dealer_logo_url": {
      "type": "string",
      "description": "Primary dealer logo URL (full-colour).",
      "nullable": true
    },
    "white_logo_url": {
      "type": "string",
      "description": "White/reversed logo URL for dark backgrounds.",
      "nullable": true
    },
    "hero_background_url": {
      "type": "string",
      "description": "Hero background image URL for the in-app dealer banner. Uploaded by the dealer to personalise the banner shown at the top of every page. Rendered with a subtle blur and dark overlay for text legibility.",
      "nullable": true
    },
    "display_name_override": {
      "type": "string",
      "description": "Optional company display name override shown in the hero banner. Null = use company_name.",
      "nullable": true
    },
    "tagline": {
      "type": "string",
      "description": "Optional company tagline shown in the hero banner beneath the dealer name.",
      "nullable": true
    },
    "address": {
      "type": "string",
      "description": "Business address shown on proposals."
    },
    "telephone": {
      "type": "string",
      "description": "Contact telephone number."
    },
    "email": {
      "type": "string",
      "description": "Contact email address."
    },
    "website": {
      "type": "string",
      "description": "Business website URL."
    },
    "linkedin": {
      "type": "string",
      "description": "LinkedIn profile URL."
    },
    "instagram": {
      "type": "string",
      "description": "Instagram profile URL."
    },
    "facebook": {
      "type": "string",
      "description": "Facebook page URL."
    },
    "youtube": {
      "type": "string",
      "description": "YouTube channel URL."
    },
    "google_maps_url": {
      "type": "string",
      "description": "Google Maps location URL (optional).",
      "nullable": true
    },
    "vat_number": {
      "type": "string",
      "description": "VAT registration number (optional).",
      "nullable": true
    },
    "company_registration_number": {
      "type": "string",
      "description": "Company registration number (optional).",
      "nullable": true
    },
    "about_us": {
      "type": "string",
      "description": "About Us marketing copy (rich text / HTML) for proposals."
    },
    "why_choose_us": {
      "type": "string",
      "description": "Why Choose Us marketing copy (rich text / HTML) for proposals."
    },
    "warranty": {
      "type": "string",
      "description": "Warranty terms text (rich text / HTML) shown on proposals."
    },
    "terms_conditions": {
      "type": "string",
      "description": "Terms & Conditions text (rich text / HTML) shown on proposals."
    },
    "primary_colour": {
      "type": "string",
      "description": "Primary brand colour (hex).",
      "default": "#213428"
    },
    "secondary_colour": {
      "type": "string",
      "description": "Secondary brand colour (hex).",
      "default": "#3E4349"
    },
    "accent_colour": {
      "type": "string",
      "description": "Accent brand colour (hex).",
      "default": "#625143"
    },
    "include_about_us": {
      "type": "boolean",
      "default": true,
      "description": "Include About Us section in new proposals by default."
    },
    "include_warranty": {
      "type": "boolean",
      "default": true,
      "description": "Include Warranty section in new proposals by default."
    },
    "include_product_gallery": {
      "type": "boolean",
      "default": true,
      "description": "Include Product Gallery in new proposals by default."
    },
    "include_rp22_overview": {
      "type": "boolean",
      "default": true,
      "description": "Include RP22 Overview in new proposals by default."
    },
    "include_technical_appendix": {
      "type": "boolean",
      "default": true,
      "description": "Include Technical Appendix in new proposals by default."
    },
    "proposal_tone": {
      "type": "string",
      "enum": [
        "luxury_residential",
        "technical",
        "architect",
        "commercial"
      ],
      "default": "luxury_residential",
      "description": "Default narrative tone for GPT-generated proposals. luxury_residential = premium home cinema language, technical = engineering-focused, architect = design-led, commercial = business/commercial cinema."
    }
  },
  "required": [
    "account_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}