{
  "name": "SpeakerSpecification",
  "type": "object",
  "description": "A versioned specification record for a SpeakerProduct. Product \u2192 Current Specification \u2192 Specification History. The SpeakerProduct.current_specification_id pointer selects the active specification; older specifications remain archived with is_current=false. Contains all physical, electrical, acoustic, and metadata specification fields. Separated from Product so product identity remains stable while specifications can evolve over time. The database knows nothing about RP22; derived values like estimated max SPL or P12 capability are computed downstream by the RP22 engine, never stored here.",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "ID of the SpeakerProduct this specification belongs to."
    },
    "version_label": {
      "type": "string",
      "description": "Version label for this specification (e.g. '2026', 'v1.2', '2026-03'). Allows future versioning without changing the Product record.",
      "default": "Current"
    },
    "is_current": {
      "type": "boolean",
      "default": true,
      "description": "Whether this is the current specification for the product. When versioned specifications are introduced, only one record per product_id should have this set to true. The SpeakerProduct.current_specification_id pointer is the authoritative link; this flag is a denormalized convenience."
    },
    "cabinet_type": {
      "type": "string",
      "description": "Physical: Cabinet type (e.g. Sealed, Ported, Passive Radiator)."
    },
    "mounting_type": {
      "type": "string",
      "description": "Physical: Mounting type (e.g. Freestanding, On Wall, In Wall, In Ceiling)."
    },
    "woofer_count": {
      "type": "number",
      "description": "Physical: Number of woofer drivers."
    },
    "woofer_size": {
      "type": "string",
      "description": "Physical: Woofer driver size (e.g. '8\"', '6.5\"')."
    },
    "midrange_count": {
      "type": "number",
      "description": "Physical: Number of midrange drivers."
    },
    "midrange_size": {
      "type": "string",
      "description": "Physical: Midrange driver size (e.g. '5\"', '4\"')."
    },
    "tweeter_description": {
      "type": "string",
      "description": "Physical: Tweeter description (e.g. '1\" soft dome', 'AMT')."
    },
    "compression_driver": {
      "type": "boolean",
      "description": "Physical: Whether the tweeter is a compression driver design."
    },
    "coaxial": {
      "type": "boolean",
      "description": "Physical: Whether the driver arrangement is coaxial."
    },
    "height_mm": {
      "type": "number",
      "description": "Physical: Cabinet height in millimeters."
    },
    "width_mm": {
      "type": "number",
      "description": "Physical: Cabinet width in millimeters."
    },
    "depth_mm": {
      "type": "number",
      "description": "Physical: Cabinet depth in millimeters."
    },
    "weight_kg": {
      "type": "number",
      "description": "Physical: Cabinet weight in kilograms."
    },
    "sensitivity_db": {
      "type": "number",
      "description": "Electrical: Sensitivity in dB (typically 1W/1m or 2.83V/1m). Valid range 75-105 dB."
    },
    "sensitivity_basis": {
      "type": "string",
      "enum": [
        "1W/1m",
        "2.83V/1m",
        "unknown"
      ],
      "default": "unknown",
      "description": "RP22 comparison: the reference basis the published sensitivity was quoted on. Required for correct 1 W / 1 m normalisation. 'unknown' is honest \u2014 the comparison assumes half space and records an assumed-basis warning. Never guessed from the value itself."
    },
    "nominal_impedance_ohm": {
      "type": "number",
      "description": "Electrical: Nominal impedance in ohms. Valid range 2-16 \u03a9."
    },
    "minimum_impedance_ohm": {
      "type": "number",
      "description": "Electrical: Minimum impedance in ohms."
    },
    "recommended_amp_min_w": {
      "type": "number",
      "description": "Electrical: Minimum recommended amplifier power in watts."
    },
    "recommended_amp_max_w": {
      "type": "number",
      "description": "Electrical: Maximum recommended amplifier power in watts."
    },
    "long_term_iec_power_w": {
      "type": "number",
      "description": "Electrical: Long-term IEC power handling in watts."
    },
    "rated_iec_power_w": {
      "type": "number",
      "description": "Electrical: Rated IEC power handling in watts."
    },
    "aes_power_w": {
      "type": "number",
      "description": "Electrical: AES power handling in watts."
    },
    "peak_power_w": {
      "type": "number",
      "description": "Electrical: Peak power handling in watts."
    },
    "power_handling_continuous_w": {
      "type": "number",
      "description": "RP22 comparison: the single continuous power figure used for P12/P13 capability. Populated only when the manufacturer states a continuous rating; left blank rather than inferred from AES/peak figures."
    },
    "power_handling_peak_w": {
      "type": "number",
      "description": "RP22 comparison: the peak power figure when the manufacturer states one. Blank when not published."
    },
    "frequency_response_low_hz": {
      "type": "number",
      "description": "Acoustic: Lowest frequency response in Hz. Valid range 10-200 Hz."
    },
    "frequency_response_high_hz": {
      "type": "number",
      "description": "Acoustic: Highest frequency response in Hz."
    },
    "frequency_response_tolerance": {
      "type": "string",
      "description": "Acoustic: Frequency response tolerance (e.g. '\u00b13dB', '-6dB')."
    },
    "frequency_response_tolerance_db": {
      "type": "number",
      "description": "RP22 comparison: numeric tolerance in dB (e.g. 6 for '-6 dB'). Blank when the manufacturer states no tolerance."
    },
    "max_continuous_spl_db": {
      "type": "number",
      "description": "Acoustic: Maximum continuous SPL in dB. Valid range 85-140 dB."
    },
    "max_peak_spl_db": {
      "type": "number",
      "description": "Acoustic: Maximum peak SPL in dB."
    },
    "max_spl_basis": {
      "type": "string",
      "enum": [
        "AES",
        "IEC",
        "continuous",
        "peak",
        "manufacturer unspecified",
        "calculated",
        "unknown"
      ],
      "default": "unknown",
      "description": "RP22 comparison: the basis behind the published max SPL figure. Drives the comparison's max-SPL basis declaration and its confidence grading. Never inferred \u2014 'manufacturer unspecified' and 'unknown' are honest answers."
    },
    "measurement_space": {
      "type": "string",
      "enum": [
        "free-space",
        "half-space",
        "in-room",
        "unspecified"
      ],
      "default": "unspecified",
      "description": "RP22 comparison: the acoustic space the published figures were measured in. free-space is converted once to the Artcoustic half-space reference; half-space is used as published; in-room and unspecified are treated as unspecified so the comparison records an assumed-basis warning instead of inventing a correction."
    },
    "horizontal_dispersion_deg": {
      "type": "number",
      "description": "Acoustic: Horizontal dispersion angle in degrees."
    },
    "vertical_dispersion_deg": {
      "type": "number",
      "description": "Acoustic: Vertical dispersion angle in degrees."
    },
    "thx_certification": {
      "type": "string",
      "description": "Acoustic: THX certification level if applicable (e.g. 'THX Ultra2', 'None')."
    },
    "primary_source": {
      "type": "string",
      "description": "Metadata: Primary source reference for the specification data."
    },
    "source_date": {
      "type": "string",
      "format": "date",
      "description": "Metadata: date the source document or page was published or last checked. Carried into the RP22 comparison row so a dealer can see how current the competitor data is."
    },
    "datasheet_url": {
      "type": "string",
      "description": "Metadata: URL of the official datasheet used as the primary source, when it differs from the product page."
    },
    "confidence": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "description": "Metadata: Confidence level. A=Published, B=Calculated, C=Estimated, D=Engineering Estimate. This is about DATA QUALITY, not approval. Values accepted from an admin-approved secondary document are held at C."
    },
    "evidence_quality": {
      "type": "string",
      "enum": [
        "Manufacturer Published",
        "Manufacturer Calculated",
        "Engineering Estimate",
        "Unknown"
      ],
      "default": "Unknown",
      "description": "Metadata: Quality of the evidence behind the specifications. A specification whose values came from an admin-approved secondary document is recorded as Engineering Estimate, and its source is stated in secondary_evidence."
    },
    "last_verified": {
      "type": "string",
      "format": "date",
      "description": "Metadata: Date the specifications were last verified against the source."
    },
    "notes": {
      "type": "string",
      "description": "Metadata: free-text engineering notes for this specification. Carried into the RP22 comparison row notes so caveats travel with the data."
    },
    "field_authority": {
      "type": "object",
      "description": "Per-field source authority. Maps specification field names to their source type (e.g. { \"sensitivity_db\": \"Official PDF\", \"max_continuous_spl_db\": \"Official Product Page\" }). Records where each individual value came from, enabling precise change tracking when the crawler later re-extracts. Keys are spec field names; values are one of: Official Product Page, Official PDF, Engineering Document, Support Article, Secondary Evidence.",
      "properties": {}
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "Draft",
        "Awaiting Review",
        "Approved",
        "Superseded",
        "Archived"
      ],
      "default": "Draft",
      "description": "Approval workflow status. Draft = entered but not yet submitted for review. Awaiting Review = submitted, waiting for a reviewer. Approved = signed off by an approver. Superseded = replaced by a newer specification version (the data was not wrong, just outdated). Archived = retired from active use. SEPARATE from Confidence (data quality) and Import Status (pipeline origin). 'Rejected' is intentionally absent \u2014 in practice data is rarely wrong; it is superseded when newer data arrives. Accepting secondary evidence never changes this."
    },
    "reviewed_by": {
      "type": "string",
      "description": "Name of the person who reviewed this specification. Eventually this will simply say 'Paul'."
    },
    "reviewed_date": {
      "type": "string",
      "format": "date",
      "description": "Date the specification was reviewed."
    },
    "approved_by": {
      "type": "string",
      "description": "Name of the person who approved this specification. When somebody changes a sensitivity six months later, this records who approved the original."
    },
    "approved_date": {
      "type": "string",
      "format": "date",
      "description": "Date the specification was approved."
    },
    "rp22_published_competitor_id": {
      "type": "string",
      "nullable": true,
      "description": "ID of the CompetitorSpeaker row this approved specification was published to. Null = never published to the RP22 comparison. Set by the 'Publish to RP22 Comparison' action, and re-pointed (never duplicated) when the same manufacturer + model is published again."
    },
    "rp22_published_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "Timestamp of the last publish to the RP22 comparison. Null = never published."
    },
    "secondary_evidence": {
      "type": "object",
      "nullable": true,
      "description": "Admin-approved secondary evidence: an original manufacturer document (product sheet, manual, brochure) hosted outside the manufacturer's own domain, for legacy or high-end models whose live official page no longer states the engineering values. Present only when an admin explicitly accepted a specific URL; never inferred, never automatic, and it never approves the specification. While present the comparison is capped at confidence C, unless the host is an official manufacturer CDN or archive.",
      "properties": {
        "source_type": {
          "type": "string",
          "description": "Always 'Secondary Evidence' \u2014 the source type recorded for these values."
        },
        "url": {
          "type": "string",
          "description": "The document or page the admin supplied and accepted."
        },
        "host": {
          "type": "string",
          "description": "Host the document was read from."
        },
        "document_type": {
          "type": "string",
          "description": "manufacturer_product_sheet, manufacturer_manual, manufacturer_brochure, dealer_page, distributor_page or unknown."
        },
        "is_official": {
          "type": "boolean",
          "description": "True only when the host belongs to the manufacturer (official CDN or archive), in which case no confidence cap applies."
        },
        "accepted_by": {
          "type": "string",
          "description": "Name of the admin who accepted this evidence."
        },
        "accepted_date": {
          "type": "string",
          "format": "date-time",
          "description": "When the evidence was accepted."
        },
        "basis": {
          "type": "string",
          "description": "'ADI estimate from secondary manufacturer document' or 'Calculated from secondary published data'."
        },
        "confidence_cap_reason": {
          "type": "string",
          "description": "Why the confidence is held where it is."
        },
        "field_quotes": {
          "type": "object",
          "description": "Per-field source sentence each accepted value was read from, keyed by field name."
        }
      }
    }
  },
  "required": [
    "product_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}