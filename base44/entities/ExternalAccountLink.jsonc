{
  "name": "ExternalAccountLink",
  "type": "object",
  "description": "Links a Sound Proof Account to one or more external ledger/trading accounts (e.g. Artcoustic Partner Portal). Supports 1:N \u2014 one Sound Proof account can have multiple external trading accounts. Required for businesses with multiple trading accounts. For Partner Portal consolidated turnover matching, exactly one active link per account should carry partner_user_id set (the canonical link); this represents the already-consolidated organisation turnover.",
  "properties": {
    "account_id": {
      "type": "string",
      "description": "ID of the Sound Proof Account this external link belongs to."
    },
    "source_system": {
      "type": "string",
      "description": "External system identifier (e.g. 'ARTCOUSTIC_PARTNER_PORTAL')."
    },
    "partner_user_id": {
      "type": "string",
      "description": "Canonical Partner Portal user_id for consolidated turnover matching. Set on exactly one active link per account for source_system='ARTCOUSTIC_PARTNER_PORTAL'. Null for non-partner links or secondary ledger reference links. Matching uses this field, not dealer name or ledger number.",
      "nullable": true
    },
    "external_account_number": {
      "type": "string",
      "description": "Account number/key in the external system. Primary ledger/account identity for reference."
    },
    "external_account_name": {
      "type": "string",
      "description": "Display name of the external account."
    },
    "currency": {
      "type": "string",
      "description": "Currency code of the external account (e.g. 'GBP', 'EUR', 'INR', 'USD')."
    },
    "territory": {
      "type": "string",
      "description": "Territory code of the external account (e.g. 'UK', 'IE', 'IN', 'DE', 'AU', 'US')."
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Inactive links are retained for historical reference but excluded from new turnover sync."
    }
  },
  "required": [
    "account_id",
    "source_system",
    "external_account_number"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "user_condition": {
                "data.access_level": "FULL_ACCESS"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}