{
  "name": "SpeakerValidation",
  "type": "object",
  "description": "A validation warning for a SpeakerProduct field. Generated when specification values fall outside expected ranges or are missing. One record per warning.",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "ID of the SpeakerProduct this warning belongs to."
    },
    "field": {
      "type": "string",
      "description": "The specification field that triggered the warning (e.g. 'sensitivity_db', 'max_continuous_spl_db')."
    },
    "severity": {
      "type": "string",
      "enum": [
        "Information",
        "Warning",
        "Critical"
      ],
      "default": "Warning",
      "description": "Severity of the validation warning."
    },
    "status": {
      "type": "string",
      "enum": [
        "Open",
        "Resolved",
        "Ignored"
      ],
      "default": "Open",
      "description": "Current status of the warning."
    },
    "message": {
      "type": "string",
      "description": "Human-readable warning message explaining the issue."
    }
  },
  "required": [
    "product_id",
    "field",
    "message"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}