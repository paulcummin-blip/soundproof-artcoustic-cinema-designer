{
  "name": "AccountUserAudit",
  "type": "object",
  "description": "Append-only audit trail for invitations, access changes, removals, invitation acceptance, Partner Portal identity claims, Portal-first activation, term starts, renewals, eligibility changes, per-user successful login tracking, welcome-email delivery, pending-invitation management (email correction, cancellation), and RS-01 Richer Sounds internal approval / central token allocation / reclamation. Written only by trusted backend functions.",
  "properties": {
    "account_id": {
      "type": "string"
    },
    "actor_user_id": {
      "type": "string"
    },
    "actor_email": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "INVITED",
        "INVITATION_RESENT",
        "INVITATION_ACCEPTED",
        "ACCESS_CHANGED",
        "REMOVED",
        "LEGACY_ADMIN_BOOTSTRAPPED",
        "PORTAL_IDENTITY_CLAIMED",
        "SOUNDPROOF_ENABLE",
        "SOUNDPROOF_SUSPEND",
        "SOUNDPROOF_RESTORE",
        "SOUNDPROOF_ELIGIBILITY_SET",
        "PORTAL_ACTIVATION_REQUESTED",
        "SOUNDPROOF_TERM_STARTED",
        "SOUNDPROOF_RENEWED",
        "USER_LOGIN_RECORDED",
        "WELCOME_EMAIL_SENT",
        "WELCOME_EMAIL_FAILED",
        "INVITATION_EMAIL_CORRECTED",
        "INVITATION_CANCELLED",
        "RS_APPROVAL_SET",
        "RS_APPROVAL_SUSPENDED",
        "RS_APPROVAL_RESTORED",
        "RS_ALLOCATION_MADE",
        "RS_ALLOCATION_RECLAIMED"
      ]
    },
    "target_user_id": {
      "type": "string",
      "nullable": true
    },
    "target_email": {
      "type": "string"
    },
    "before_access_level": {
      "type": "string",
      "nullable": true,
      "description": "For RS approval actions this carries the previous rs_approval_status; for allocation/reclaim it may carry the previous capacity context."
    },
    "after_access_level": {
      "type": "string",
      "nullable": true,
      "description": "For RS approval actions this carries the new rs_approval_status; for allocation/reclaim it may carry the new capacity context."
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "details": {
      "type": "object",
      "nullable": true,
      "description": "For RS-01 actions: actor_is_master_admin (bool), actor_is_rs_delegated_admin (bool), master_account_id, previous_rs_approval_status, new_rs_approval_status, amount, transfer_id, reclaim_of, note."
    }
  },
  "required": [
    "account_id",
    "actor_user_id",
    "actor_email",
    "action",
    "target_email",
    "occurred_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": false,
    "delete": false
  }
}