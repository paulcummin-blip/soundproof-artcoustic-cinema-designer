{
  "name": "AccountMembership",
  "type": "object",
  "description": "Canonical account seat and membership record. One active or pending record represents one of the account's five login seats, including the single account administrator.",
  "properties": {
    "user_id": {
      "type": "string",
      "nullable": true,
      "description": "Base44 User id after the invitation has produced or matched a user record."
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Normalised invited/login email. Present for pending and active seats."
    },
    "full_name": {
      "type": "string",
      "nullable": true,
      "description": "Display name copied from the linked user when available."
    },
    "account_id": {
      "type": "string",
      "description": "Owning Account id."
    },
    "membership_role": {
      "type": "string",
      "enum": [
        "distributor_admin",
        "dealer_admin",
        "full_access",
        "sound_proof_only",
        "price_list_only",
        "internal_admin",
        "designer",
        "viewer"
      ],
      "description": "Relationship role. Legacy designer/viewer values remain readable; new dealer seats use dealer_admin/full_access/sound_proof_only/price_list_only."
    },
    "access_level": {
      "type": "string",
      "enum": [
        "FULL_ACCESS",
        "SOUND_PROOF_ONLY",
        "PRICE_LIST_ONLY"
      ],
      "default": "FULL_ACCESS",
      "description": "Authoritative module access for this account seat."
    },
    "is_account_admin": {
      "type": "boolean",
      "default": false,
      "description": "True only for the account's single local administrator. The admin always has FULL_ACCESS."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "suspended",
        "removed"
      ],
      "default": "pending",
      "description": "Pending invitations and active members consume one of five seats. Removed members do not."
    },
    "invited_by_user_id": {
      "type": "string",
      "nullable": true
    },
    "invited_by_email": {
      "type": "string",
      "nullable": true
    },
    "invited_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true
    },
    "removed_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true
    },
    "removed_by_user_id": {
      "type": "string",
      "nullable": true
    }
  },
  "required": [
    "email",
    "account_id",
    "membership_role",
    "access_level"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}