{
  "name": "ProposalSection",
  "type": "object",
  "description": "An editable content block within a client-facing design report (the Proposal Block entity). The section set is fixed by report type \u2014 dealers can hide and reorder but cannot add custom sections. A proposal uses the 10 proposal sections; a System Design Summary uses its own 8 sections built around the three core RP22 design structures. Each block has rich-text HTML body, dealer notes (invisible to client, fed to GPT on regeneration), lock state, and GPT/edit timestamps.",
  "properties": {
    "proposal_id": {
      "type": "string",
      "description": "ID of the Proposal this block belongs to."
    },
    "account_id": {
      "type": "string",
      "description": "Denormalized account_id for RLS."
    },
    "section_type": {
      "type": "string",
      "enum": [
        "cover",
        "executive_summary",
        "design_philosophy",
        "system_overview",
        "room_images",
        "performance",
        "products",
        "comparison",
        "conclusion",
        "appendix",
        "system_design_summary",
        "spatial_resolution",
        "dynamic_range",
        "timbre_matching",
        "key_performance_highlights",
        "overall_design"
      ],
      "description": "Fixed report section type. A proposal uses cover, executive_summary, design_philosophy, system_overview, room_images, performance, products, comparison, conclusion, appendix. A System Design Summary uses cover, system_design_summary, spatial_resolution, dynamic_range, timbre_matching, key_performance_highlights, overall_design, room_images. Dealers can hide and reorder but cannot add custom sections. This gives Sound Proof reports a recognisable, consistent structure."
    },
    "section_key": {
      "type": "string",
      "description": "Stable slug identifier for this block (e.g. 'executive_summary', 'spatial_resolution'). Used as a stable reference even if the display title changes."
    },
    "title": {
      "type": "string",
      "description": "Display heading for this block shown on the proposal."
    },
    "body": {
      "type": "string",
      "description": "Rich text / HTML body content. Populated by GPT generation; editable by the designer in the Proposal Editor. This is the primary content storage block."
    },
    "dealer_notes": {
      "type": "string",
      "description": "Dealer-only notes for this section. Never rendered in the exported proposal. Supplied to GPT as context during section regeneration. Effectively invisible prompt engineering \u2014 the dealer guides GPT without the client ever seeing it.",
      "default": "",
      "nullable": true
    },
    "order_index": {
      "type": "number",
      "default": 0,
      "description": "Display order within the proposal. Set by the section type ordering; adjustable via drag-and-drop in the left navigation."
    },
    "is_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether this block is included in the proposal. Dealers hide sections by setting this to false \u2014 the section remains in the database but is not rendered or exported."
    },
    "locked": {
      "type": "boolean",
      "default": false,
      "description": "When true, this block's content is locked and GPT regeneration will not modify it without explicit confirmation. The designer has final say on locked blocks. Locked sections show a confirmation dialog before regeneration."
    },
    "last_gpt_generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last GPT generation that populated this block. Null = never GPT-generated.",
      "nullable": true
    },
    "last_user_edited_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last manual user edit to this block. Null = never manually edited.",
      "nullable": true
    },
    "metadata": {
      "type": "object",
      "description": "Block-specific configuration and calculated content. For the Key Performance Highlights section this holds { highlight_rows: [{ key, area, result, what_you_hear }] } \u2014 the calculated table rows rendered by the app. The Result values are read from calculated data; only what_you_hear is generated prose.",
      "properties": {
        "highlight_rows": {
          "type": "array",
          "description": "Calculated Key Performance Highlights table rows. area and result come from Sound Proof calculated data; what_you_hear is the generated client-facing description of that result.",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "area": {
                "type": "string"
              },
              "result": {
                "type": "string"
              },
              "what_you_hear": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "proposal_id",
    "account_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}