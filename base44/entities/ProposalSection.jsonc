{
  "name": "ProposalSection",
  "type": "object",
  "description": "An editable content block within a proposal (the Proposal Block entity). Fixed 10 section types \u2014 dealers can hide and reorder but cannot add custom sections. Each block has rich-text HTML body, dealer notes (invisible to client, fed to GPT on regeneration), lock state, and GPT/edit timestamps.",
  "properties": {
    "proposal_id": {
      "type": "string",
      "description": "ID of the Proposal this block belongs to."
    },
    "account_id": {
      "type": "string",
      "description": "Denormalized account_id for RLS."
    },
    "section_type": {
      "type": "string",
      "enum": [
        "cover",
        "executive_summary",
        "design_philosophy",
        "system_overview",
        "room_images",
        "performance",
        "products",
        "comparison",
        "conclusion",
        "appendix"
      ],
      "description": "Fixed proposal section type. These 10 types are the same for every proposal \u2014 dealers can hide and reorder but cannot add custom sections. This gives Sound Proof proposals a recognisable, consistent structure."
    },
    "section_key": {
      "type": "string",
      "description": "Stable slug identifier for this block (e.g. 'executive_summary', 'system_overview'). Used as a stable reference even if the display title changes."
    },
    "title": {
      "type": "string",
      "description": "Display heading for this block shown on the proposal."
    },
    "body": {
      "type": "string",
      "description": "Rich text / HTML body content. Populated by GPT generation; editable by the designer in the Proposal Editor. This is the primary content storage block."
    },
    "dealer_notes": {
      "type": "string",
      "description": "Dealer-only notes for this section. Never rendered in the exported proposal. Supplied to GPT as context during section regeneration. Effectively invisible prompt engineering \u2014 the dealer guides GPT without the client ever seeing it.",
      "default": "",
      "nullable": true
    },
    "order_index": {
      "type": "number",
      "default": 0,
      "description": "Display order within the proposal. Set by the section type ordering; adjustable via drag-and-drop in the left navigation."
    },
    "is_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether this block is included in the proposal. Dealers hide sections by setting this to false \u2014 the section remains in the database but is not rendered or exported."
    },
    "locked": {
      "type": "boolean",
      "default": false,
      "description": "When true, this block's content is locked and GPT regeneration will not modify it without explicit confirmation. The designer has final say on locked blocks. Locked sections show a confirmation dialog before regeneration."
    },
    "last_gpt_generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last GPT generation that populated this block. Null = never GPT-generated.",
      "nullable": true
    },
    "last_user_edited_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last manual user edit to this block. Null = never manually edited.",
      "nullable": true
    },
    "metadata": {
      "type": "object",
      "description": "Block-specific configuration for GPT generation (e.g. prompt overrides, data bindings).",
      "properties": {}
    }
  },
  "required": [
    "proposal_id",
    "account_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}