{
  "name": "ProposalSection",
  "type": "object",
  "description": "Editable narrative block with durable frozen calculated table metadata. A generated narrative section also carries the designer's own approval of its wording in metadata.approval: the state, who gave it, when, and the fingerprint of the exact content that was approved. The fingerprint is compared against the section's current content every time the document is read, so a stored approval stops counting the moment that section's wording changes.",
  "properties": {
    "proposal_id": {
      "type": "string"
    },
    "account_id": {
      "type": "string"
    },
    "section_type": {
      "type": "string",
      "enum": [
        "cover",
        "executive_summary",
        "design_philosophy",
        "system_overview",
        "room_images",
        "performance",
        "products",
        "comparison",
        "conclusion",
        "appendix",
        "system_design_summary",
        "spatial_resolution",
        "dynamic_range",
        "timbre_matching",
        "key_performance_highlights",
        "overall_design"
      ]
    },
    "section_key": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "dealer_notes": {
      "type": "string",
      "default": "",
      "nullable": true
    },
    "order_index": {
      "type": "number",
      "default": 0
    },
    "is_enabled": {
      "type": "boolean",
      "default": true
    },
    "locked": {
      "type": "boolean",
      "default": false
    },
    "last_gpt_generated_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true
    },
    "last_user_edited_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true
    },
    "metadata": {
      "type": "object",
      "properties": {
        "highlight_rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "area": {
                "type": "string"
              },
              "result": {
                "type": "string"
              },
              "what_you_hear": {
                "type": "string"
              }
            }
          }
        },
        "comparison": {
          "type": "boolean"
        },
        "comparison_versions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "version_id": {
                "type": "string",
                "nullable": true
              },
              "version_name": {
                "type": "string",
                "nullable": true
              },
              "label": {
                "type": "string"
              },
              "source_identity": {
                "type": "object",
                "additionalProperties": true,
                "description": "Frozen evidence identity and available fingerprints."
              }
            }
          }
        },
        "comparison_rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "area": {
                "type": "string"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "identical": {
                "type": "boolean"
              },
              "change": {
                "type": "string",
                "nullable": true
              },
              "client_meaning": {
                "type": "string"
              }
            }
          }
        },
        "approval": {
          "type": "object",
          "description": "The designer's approval of this section's wording. Written only by approveProposalSection, never by a save, a generation, a preview or a read. Absent = the section has never been approved. It stops counting automatically when the section's content no longer matches fingerprint.",
          "nullable": true,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "approved"
              ],
              "description": "Always 'approved'. A section that is not approved carries no approval at all, so there is no second state to keep in step."
            },
            "approved_at": {
              "type": "string",
              "format": "date-time",
              "description": "When the designer approved this wording."
            },
            "approved_by": {
              "type": "string",
              "description": "Name or email of the person who approved it."
            },
            "fingerprint": {
              "type": "string",
              "description": "The fingerprint of the content that was on screen when the approval was given. Compared against the section's current content on every read; a mismatch means the wording changed, so the approval no longer counts."
            }
          }
        }
      }
    }
  },
  "required": [
    "proposal_id",
    "account_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}