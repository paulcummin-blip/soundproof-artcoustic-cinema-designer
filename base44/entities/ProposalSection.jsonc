{
  "name": "ProposalSection",
  "type": "object",
  "description": "An editable content block within a client-facing design report. Sections retain frozen calculated table metadata independently of narrative edits.",
  "properties": {
    "proposal_id": {
      "type": "string"
    },
    "account_id": {
      "type": "string"
    },
    "section_type": {
      "type": "string",
      "enum": [
        "cover",
        "executive_summary",
        "design_philosophy",
        "system_overview",
        "room_images",
        "performance",
        "products",
        "comparison",
        "conclusion",
        "appendix",
        "system_design_summary",
        "spatial_resolution",
        "dynamic_range",
        "timbre_matching",
        "key_performance_highlights",
        "overall_design"
      ]
    },
    "section_key": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "dealer_notes": {
      "type": "string",
      "default": "",
      "nullable": true
    },
    "order_index": {
      "type": "number",
      "default": 0
    },
    "is_enabled": {
      "type": "boolean",
      "default": true
    },
    "locked": {
      "type": "boolean",
      "default": false
    },
    "last_gpt_generated_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true
    },
    "last_user_edited_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true
    },
    "metadata": {
      "type": "object",
      "properties": {
        "highlight_rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "area": {
                "type": "string"
              },
              "result": {
                "type": "string"
              },
              "what_you_hear": {
                "type": "string"
              }
            }
          }
        },
        "comparison": {
          "type": "boolean"
        },
        "comparison_versions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "version_id": {
                "type": "string",
                "nullable": true
              },
              "version_name": {
                "type": "string",
                "nullable": true
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "comparison_rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "area": {
                "type": "string"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "identical": {
                "type": "boolean"
              },
              "change": {
                "type": "string",
                "nullable": true
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "proposal_id",
    "account_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}