{
  "name": "ProposalSection",
  "type": "object",
  "description": "An editable content block within a proposal (the Proposal Block entity). Designed so GPT-generated content can later be stored in structured, individually editable blocks. Each block has a type, stable key, heading, rich-text body (HTML), lock state, and GPT/edit timestamps. Stage 1: database only \u2014 no generation, no editing UI. Stage 2 adds locked, last_gpt_generated_at, last_user_edited_at \u2014 still no GPT, no editor.",
  "properties": {
    "proposal_id": {
      "type": "string",
      "description": "ID of the Proposal this block belongs to."
    },
    "account_id": {
      "type": "string",
      "description": "Denormalized account_id for RLS."
    },
    "section_type": {
      "type": "string",
      "enum": [
        "hero",
        "intro",
        "system_summary",
        "room_analysis",
        "speaker_schedule",
        "bass_performance",
        "rp22_compliance",
        "pricing",
        "gallery",
        "warranty",
        "terms",
        "custom"
      ],
      "description": "Type of proposal block. Determines how the body content is rendered and which data source feeds it."
    },
    "section_key": {
      "type": "string",
      "description": "Stable slug identifier for this block (e.g. 'hero', 'system_summary'). Used as a stable reference even if the display title changes."
    },
    "title": {
      "type": "string",
      "description": "Display heading for this block shown on the proposal."
    },
    "body": {
      "type": "string",
      "description": "Rich text / HTML body content. Populated by GPT generation in future stages; editable by the designer. This is the primary GPT-content storage block."
    },
    "order_index": {
      "type": "number",
      "default": 0,
      "description": "Display order within the proposal."
    },
    "is_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether this block is included in the proposal."
    },
    "locked": {
      "type": "boolean",
      "default": false,
      "description": "When true, this block's content is locked and GPT regeneration will not modify it. The designer has final say on locked blocks."
    },
    "last_gpt_generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last GPT generation that populated this block. Null = never GPT-generated.",
      "nullable": true
    },
    "last_user_edited_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last manual user edit to this block. Null = never manually edited.",
      "nullable": true
    },
    "metadata": {
      "type": "object",
      "description": "Block-specific configuration for future GPT generation (e.g. prompt overrides, data bindings, tone).",
      "properties": {}
    }
  },
  "required": [
    "proposal_id",
    "account_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": {
                "$nin": [
                  null,
                  ""
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.access_level": "FULL_ACCESS"
                  }
                },
                {
                  "user_condition": {
                    "data.access_level": "SOUND_PROOF_ONLY"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}