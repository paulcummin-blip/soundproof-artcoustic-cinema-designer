{
  "type": "object",
  "properties": {
    "manufacturer": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "product_type": {
      "type": "string"
    },
    "open_back": {
      "type": "string",
      "description": "Whether the speaker is an open-back design (Y/N). Open-back in-wall speakers are subject to inconsistent installed results."
    },
    "retail_price_inc_vat": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    },
    "rated_impedance_ohm": {
      "type": "number"
    },
    "minimum_impedance_ohm": {
      "type": "number"
    },
    "sensitivity_value_db": {
      "type": "number"
    },
    "sensitivity_reference": {
      "type": "string"
    },
    "sensitivity_impedance_used_ohm": {
      "type": "number"
    },
    "sensitivity_band_conditions": {
      "type": "string"
    },
    "continuous_power_w": {
      "type": "number"
    },
    "power_rating_type": {
      "type": "string"
    },
    "program_power_w": {
      "type": "number"
    },
    "peak_power_w": {
      "type": "number"
    },
    "published_max_continuous_spl_db_1m": {
      "type": "number"
    },
    "published_max_peak_spl_db_1m": {
      "type": "number"
    },
    "max_spl_test_conditions": {
      "type": "string"
    },
    "frequency_range": {
      "type": "string"
    },
    "usable_lf_minus6db_hz": {
      "type": "number"
    },
    "horizontal_coverage_deg": {
      "type": "number"
    },
    "vertical_coverage_deg": {
      "type": "number"
    },
    "recommended_amplifier_power_w": {
      "type": "number"
    },
    "recommended_amp_min_w": {
      "type": "number",
      "description": "Lower bound of the manufacturer recommended amplifier power range, in watts. Null when not specified."
    },
    "recommended_amp_max_w": {
      "type": "number",
      "description": "Upper bound of the manufacturer recommended amplifier power range, in watts. Used as a ceiling on effective amplifier power for SPL capability calculations. Null when not specified."
    },
    "source_url": {
      "type": "string"
    },
    "datasheet_url": {
      "type": "string"
    },
    "date_checked": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "normalized_sensitivity_db_1w_1m": {
      "type": "number",
      "description": "Voltage-to-watt normalization only, in the raw published measurement space."
    },
    "normalized_continuous_power_w": {
      "type": "number"
    },
    "calculated_max_continuous_spl_db_1m": {
      "type": "number",
      "description": "Sensitivity plus continuous power in the raw published space; comparison uses the separate halfspace field."
    },
    "spl_authority": {
      "type": "string"
    },
    "data_confidence": {
      "type": "string"
    },
    "p12_p13_eligible": {
      "type": "boolean"
    },
    "import_batch": {
      "type": "string"
    },
    "active": {
      "type": "boolean"
    },
    "voltage_to_1w_correction_db": {
      "type": "number"
    },
    "space_correction_db": {
      "type": "number"
    },
    "halfspace_sensitivity_db_1w_1m": {
      "type": "number"
    },
    "halfspace_published_max_continuous_spl_db_1m": {
      "type": "number"
    },
    "halfspace_published_max_peak_spl_db_1m": {
      "type": "number"
    },
    "halfspace_calculated_max_continuous_spl_db_1m": {
      "type": "number"
    },
    "measurement_space_basis": {
      "type": "string",
      "description": "Legacy combined measurement basis (Full Space or Half Space). Superseded by the independent sensitivity_measurement_basis and max_spl_measurement_basis fields. Retained for backward compatibility \u2014 used as fallback when the independent fields are blank."
    },
    "sensitivity_measurement_basis": {
      "type": "string",
      "description": "Independent sensitivity measurement basis: Full Space or Half Space. Blank/Unknown/unstated assumes Half Space (0 dB correction). Full Space receives +6 dB once to convert to Artcoustic half-space."
    },
    "max_spl_measurement_basis": {
      "type": "string",
      "description": "Independent max SPL measurement basis: Full Space or Half Space. Blank/Unknown/unstated assumes Half Space (0 dB correction). Full Space receives +6 dB once to convert to Artcoustic half-space."
    },
    "sensitivity_space_provenance": {
      "type": "string",
      "description": "Provenance of the sensitivity space correction: half_space_published, half_space_assumed, or full_space_published_converted."
    },
    "max_spl_space_provenance": {
      "type": "string",
      "description": "Provenance of the max SPL space correction: half_space_published, half_space_assumed, or full_space_published_converted."
    },
    "measurement_basis_status": {
      "type": "string"
    },
    "normalization_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_product_id": {
      "type": "string",
      "nullable": true,
      "description": "ID of the SpeakerProduct this row was published from. Set only by 'Publish to RP22 Comparison'. Null for legacy spreadsheet-imported rows. Used to protect database-published rows from being replaced by a spreadsheet import."
    },
    "source_specification_id": {
      "type": "string",
      "nullable": true,
      "description": "ID of the approved SpeakerSpecification this row was published from, so the comparison row is always traceable to its approval record."
    },
    "publish_source": {
      "type": "string",
      "enum": [
        "speaker_database",
        "spreadsheet"
      ],
      "nullable": true,
      "description": "Where this comparison row came from. 'speaker_database' = published from an approved specification (source of truth, protected from spreadsheet replacement). 'spreadsheet' = legacy/master-admin spreadsheet import. Null = pre-provenance historical row."
    },
    "published": {
      "type": "boolean",
      "default": false,
      "description": "Whether this row is approved for RP22 comparison. Database-sourced rows appear on the RP22 page only when true; legacy rows without publish provenance remain visible as before."
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "Timestamp of the last publish or spreadsheet import that wrote this row."
    },
    "approval_status": {
      "type": "string",
      "nullable": true,
      "description": "Approval status of the source specification at publish time (always 'Approved'). Shown in the comparison hover panel as the verification status. Null for legacy spreadsheet rows."
    },
    "source_confidence": {
      "type": "string",
      "nullable": true,
      "description": "Confidence (A/B/C/D) of the source specification at publish time, so the comparison row states how well evidenced its data is."
    },
    "source_evidence_quality": {
      "type": "string",
      "nullable": true,
      "description": "Evidence quality of the source specification at publish time (Manufacturer Published, Manufacturer Calculated, Engineering Estimate, Unknown)."
    },
    "spec_version_label": {
      "type": "string",
      "nullable": true,
      "description": "Version label of the source specification at publish time, for audit between the review database and the comparison row."
    }
  },
  "required": [
    "manufacturer",
    "model"
  ],
  "name": "CompetitorSpeaker",
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}